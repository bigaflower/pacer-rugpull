{
    "DT": {
        "_transfer(address,address,uint256)": [
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "canSwap && ! inSwap && from != uniswapV2Pair && swapEnabled && ! _isExcludedFromFee[from] && ! _isExcludedFromFee[to]"
            },
            {
                "Expr": "burnTokens(burntAmount)",
                "Trapdoor": "canSwap && ! inSwap && from != uniswapV2Pair && swapEnabled && ! _isExcludedFromFee[from] && ! _isExcludedFromFee[to]"
            }
        ]
    },
    "DPW": {},
    "IDT": {
        "createPair()": [
            {
                "Expr": "uniswapV2Router = _uniswapV2Router",
                "W_TDS": "['uniswapV2Router']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "uniswapV2Pair = IUniswapV2Factory(_uniswapV2Router.factory()).createPair(address(this),_uniswapV2Router.WETH())",
                "W_TDS": "['uniswapV2Pair']",
                "Trapdoor": "Modifier"
            }
        ],
        "setTrading()": [
            {
                "Expr": "tradingOpen = true",
                "W_TDS": "['tradingOpen']",
                "Trapdoor": "Modifier"
            }
        ],
        "addSniper(address[])": [
            {
                "Expr": "_isSniper[snipers[i]] = true",
                "W_TDS": "['_isSniper']",
                "Trapdoor": "Modifier"
            }
        ],
        "removeSniper(address)": [
            {
                "Expr": "_isSniper[sniper] = false",
                "W_TDS": "['_isSniper']",
                "Trapdoor": "Modifier"
            }
        ],
        "toggleSwap(bool)": [
            {
                "Expr": "swapEnabled = _swapEnabled",
                "W_TDS": "['swapEnabled']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMaxTxnAmount(uint256)": [
            {
                "Expr": "_maxTxAmount = maxTxAmount",
                "W_TDS": "['_maxTxAmount']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMaxWalletSize(uint256)": [
            {
                "Expr": "_maxWalletSize = maxWalletSize",
                "W_TDS": "['_maxWalletSize']",
                "Trapdoor": "Modifier"
            }
        ],
        "setBurnFee(uint256)": [
            {
                "Expr": "_burnFee = amount",
                "W_TDS": "['_burnFee']",
                "Trapdoor": "Modifier"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "_isSniper[to] = true",
                "W_TDS": "['_isSniper']",
                "Trapdoor": "canSwap && ! inSwap && from != uniswapV2Pair && swapEnabled && ! _isExcludedFromFee[from] && ! _isExcludedFromFee[to]"
            },
            {
                "Expr": "_isSniper[to] = true",
                "W_TDS": "['_isSniper']",
                "Trapdoor": "(_isExcludedFromFee[from] || _isExcludedFromFee[to]) || (from != uniswapV2Pair && to != uniswapV2Pair)"
            }
        ],
        "constructor": [
            {
                "Expr": "_isExcludedFromFee[_marketingAddress] = true",
                "W_TDS": "['_isExcludedFromFee']",
