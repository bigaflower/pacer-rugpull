{
    "DT": {
        "Trade(uint256,uint256,bytes32,address,address)": [
            {
                "Expr": "_seller.transfer(total)",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_seller.transfer(total)",
                "Trapdoor": "balanceOf[_buyer] + _qty < balanceOf[_buyer]"
            },
            {
                "Expr": "_seller.transfer(total)",
                "Trapdoor": "balanceOf[_seller] < _qty"
            }
        ]
    },
    "DPW": {
        "Trade(uint256,uint256,bytes32,address,address)": [
            {
                "Expr": "balanceOf[_buyer] += _qty",
                "WPState": "['balanceOf']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "balanceOf[_seller] -= _qty",
