{
    "DT": {
        "createLiquidity()": [
            {
                "Expr": "_uniswapV2Router.addLiquidityETH{value: address(this).balance}(address(this),initialLiquidity,0,0,msg.sender,block.timestamp)",
                "Trapdoor": "Modifier"
            }
        ],
        "withdraw()": [
            {
                "Expr": "_withdraw()",
                "Trapdoor": "Modifier"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "super._transfer(from,to,amount)",
                "Trapdoor": "from == uniswapPair && ! _isExcludedFromFee[to]"
            },
            {
                "Expr": "super._transfer(from,to,amount)",
                "Trapdoor": "! _inSwap && uniswapPair != address(0) && to == uniswapPair && ! _isExcludedFromFee[from]"
            }
        ]
    },
    "DPW": {
