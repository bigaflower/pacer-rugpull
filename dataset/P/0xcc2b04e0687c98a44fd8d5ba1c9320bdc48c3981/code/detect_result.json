{
    "DT": {
        "_transfer(address,address,uint256)": [
            {
                "Expr": "swapAndLiquify(contractTokenBalance)",
                "Trapdoor": "overMinTokenBalance && ! inSwapAndLiquify && from != uniswapV2Pair && swapAndLiquifyEnabled"
            }
        ]
    },
    "DPW": {},
    "IDT": {
        "_setdevWallet(address)": [
            {
                "Expr": "_devWalletAddress = devWalletAddress",
                "W_TDS": "['_devWalletAddress']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMaxTxPercent(uint256)": [
            {
                "Expr": "_maxTxAmount = _tTotal.mul(maxTxPercent).div(10 ** 2)",
                "W_TDS": "['_maxTxAmount']",
                "Trapdoor": "Modifier"
            }
        ],
        "setSwapAndLiquifyEnabled(bool)": [
            {
                "Expr": "swapAndLiquifyEnabled = _enabled",
                "W_TDS": "['swapAndLiquifyEnabled']",
                "Trapdoor": "Modifier"
