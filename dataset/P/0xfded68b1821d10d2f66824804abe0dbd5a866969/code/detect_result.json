{
    "DT": {
        "_transfer(address,address,uint256)": [
            {
                "Expr": "swapAndLiquify(contractTokenBalance)",
                "Trapdoor": "! isTXNoLimit[sender] && ! isTXNoLimit[recipient]"
            },
            {
                "Expr": "swapAndLiquify(contractTokenBalance)",
                "Trapdoor": "overMinimumTokenBalance && ! inSwapAndLiquify && ! isMarketPair[sender] && swapAndLiquifyEnabled"
            }
        ],
        "swapAndLiquify(uint256)": [
            {
                "Expr": "transferToAddressETH(marketingaddress,amountETHMarketing)",
                "Trapdoor": "totalETHFee = _totalDistributionShares.sub(_lratio.div(2))"
            },
            {
                "Expr": "addLiquidity(tokensForLP,amountETHLiquidity)",
                "Trapdoor": "totalETHFee = _totalDistributionShares.sub(_lratio.div(2))"
            },
            {
                "Expr": "addLiquidity(tokensForLP,amountETHLiquidity)",
                "Trapdoor": "tokensForLP = tAmount.mul(_lratio).div(_totalDistributionShares).div(2)"
            },
            {
                "Expr": "transferToAddressETH(marketingaddress,amountETHTeam)",
                "Trapdoor": "totalETHFee = _totalDistributionShares.sub(_lratio.div(2))"
            }
        ]
    },
    "DPW": {
        "constructor": [
            {
                "Expr": "_allowances[address(this)][address(uniswapV2Router)] = _totalSupply",
                "WPState": "['_allowances']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDT": {
        "setMarketPairStatus(address,bool)": [
            {
                "Expr": "isMarketPair[account] = newValue",
                "W_TDS": "['isMarketPair']",
                "Trapdoor": "Modifier"
            }
        ],
        "updatelimit(uint256,uint256)": [
            {
                "Expr": "_maxTxAmount = newbuylimit",
                "W_TDS": "['_maxTxAmount']",
                "Trapdoor": "Modifier"
            }
        ],
        "setNumTokensBeforeSwap(uint256)": [
            {
                "Expr": "minimumTokensBeforeSwap = newLimit",
                "W_TDS": "['minimumTokensBeforeSwap']",
                "Trapdoor": "Modifier"
            }
        ],
        "_setSwapAndLiquifyEnabled(bool)": [
            {
                "Expr": "swapAndLiquifyEnabled = _enabled",
                "W_TDS": "['swapAndLiquifyEnabled']",
                "Trapdoor": "Modifier"
            }
        ],
        "setAntiSniper(address)": [
            {
                "Expr": "isSniper[_account] = false",
                "W_TDS": "['isSniper']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "isSniper[_account] = true",
                "W_TDS": "['isSniper']",
                "Trapdoor": "Modifier"
            }
        ],
        "constructor": [
            {
                "Expr": "isTXNoLimit[address(this)] = true",
                "W_TDS": "['isTXNoLimit']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDPW": {
        "constructor": [
            {
                "Expr": "uniswapV2Router = _uniswapV2Router",
                "W_PSWDS": "['uniswapV2Router']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "FLAG": true
}