{
    "DT": {
        "addLiquidity()": [
            {
                "Expr": "uniswapV2Router.addLiquidityETH{value: address(this).balance}(address(this),balanceOf(address(this)),0,0,owner(),block.timestamp)",
                "Trapdoor": "Modifier"
            }
        ],
        "transferFrom(address,address,uint256)": [
            {
                "Expr": "_transfer(sender,recipient,amount)",
                "Trapdoor": "_tradingOpen && ! _isExcludedFromFee[recipient] && sender == uniswapV2Pair"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "from == uniswapV2Pair && to != address(uniswapV2Router) && ! _isExcludedFromFee[to]"
            }
        ],
        "manualsend()": [
            {
                "Expr": "sendETHToFee(contractETHBalance)",
                "Trapdoor": "require(bool)(_msgSender() == _FeeAddress1)"
            }
        ]
    },
    "DPW": {
        "addLiquidity()": [
            {
                "Expr": "uniswapV2Pair = IUniswapV2Factory(_uniswapV2Router.factory()).createPair(address(this),_uniswapV2Router.WETH())",
                "WPState": "['uniswapV2Pair']",
                "Trapdoor": "Modifier"
            }
        ],
        "openTrading()": [
            {
                "Expr": "_tradingOpen = true",
                "WPState": "['_tradingOpen']",
                "Trapdoor": "Modifier"
            }
        ],
        "constructor": [
            {
                "Expr": "_isExcludedFromFee[FeeAddress2] = true",
                "WPState": "['_isExcludedFromFee']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDT": {
        "addLiquidity()": [
            {
                "Expr": "uniswapV2Router = _uniswapV2Router",
                "W_TDS": "['uniswapV2Router']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "uniswapV2Pair = IUniswapV2Factory(_uniswapV2Router.factory()).createPair(address(this),_uniswapV2Router.WETH())",
                "W_TDS": "['uniswapV2Pair']",
                "Trapdoor": "Modifier"
            }
        ],
        "openTrading()": [
            {
                "Expr": "_tradingOpen = true",
                "W_TDS": "['_tradingOpen']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_maxTradeAmount = 500000000000000 * 10 ** 9",
                "W_TDS": "['_maxTradeAmount']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_maxWalletHoldings = 2500000000000000 * 10 ** 9",
                "W_TDS": "['_maxWalletHoldings']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_launchedAt = block.timestamp",
                "W_TDS": "['_launchedAt']",
                "Trapdoor": "Modifier"
            }
        ],
        "toggleImpactFee(bool)": [
            {
                "Expr": "_useImpactFeeSetter = onoff",
                "W_TDS": "['_useImpactFeeSetter']",
                "Trapdoor": "Modifier"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "cooldown[to] = User(0,true)",
                "W_TDS": "['cooldown']",
                "Trapdoor": "from == uniswapV2Pair && to != address(uniswapV2Router) && ! _isExcludedFromFee[to]"
            },
            {
                "Expr": "cooldown[to].buy = block.timestamp",
                "W_TDS": "['cooldown']",
                "Trapdoor": "from == uniswapV2Pair && to != address(uniswapV2Router) && ! _isExcludedFromFee[to]"
            }
        ],
        "setFeeRate(uint256)": [
            {
                "Expr": "_feeRate = rate",
                "W_TDS": "['_feeRate']",
                "Trapdoor": "require(bool)(_msgSender() == _FeeAddress1)"
            }
        ],
        "updateFeeAddress1(address)": [
            {
                "Expr": "_FeeAddress1 = address(newAddress)",
                "W_TDS": "['_FeeAddress1']",
                "Trapdoor": "require(bool)(_msgSender() == _FeeAddress1)"
            }
        ],
        "setBot(address)": [
            {
                "Expr": "_isBot[botwallet] = true",
                "W_TDS": "['_isBot']",
                "Trapdoor": "require(bool)(_msgSender() == _FeeAddress1)"
            }
        ],
        "delBot(address)": [
            {
                "Expr": "_isBot[botwallet] = false",
                "W_TDS": "['_isBot']",
                "Trapdoor": "require(bool)(_msgSender() == _FeeAddress1)"
            }
        ],
        "updateFeeAddress2(address)": [
            {
                "Expr": "_FeeAddress2 = address(newAddress)",
                "W_TDS": "['_FeeAddress2']",
                "Trapdoor": "require(bool)(_msgSender() == _FeeAddress2)"
            }
        ],
        "constructor": [
            {
                "Expr": "_isExcludedFromFee[FeeAddress2] = true",
                "W_TDS": "['_isExcludedFromFee']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDPW": {
        "openTrading()": [
            {
                "Expr": "_tradingOpen = true",
                "W_PSWDS": "['_tradingOpen']",
                "Trapdoor": "Modifier"
            }
        ]
    },
    "FLAG": true
}