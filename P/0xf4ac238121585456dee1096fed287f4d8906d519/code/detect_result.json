                "WPState": "['balanceOf']",
                "Trapdoor": "balanceOf[_buyer] + _qty < balanceOf[_buyer]"
            }
        ],
        "batchTransfer(address[],uint256)": [
            {
                "Expr": "balanceOf[msg.sender] -= amount",
                "WPState": "['balanceOf']",
                "Trapdoor": "balanceOf[msg.sender] < amount"
            }
        ],
        "transfer(address,uint256)": [
            {
                "Expr": "balanceOf[msg.sender] -= _value",
                "WPState": "['balanceOf']",
                "Trapdoor": "_value > balanceOf[msg.sender] || (balanceOf[_to] + _value) < balanceOf[_to]"
            },
            {
                "Expr": "balanceOf[_to] += _value",
                "WPState": "['balanceOf']",
                "Trapdoor": "_value > balanceOf[msg.sender] || (balanceOf[_to] + _value) < balanceOf[_to]"
            }
        ],
        "transferFrom(address,address,uint256)": [
            {
                "Expr": "balanceOf[_to] += _value",
                "WPState": "['balanceOf']",
                "Trapdoor": "_value > balanceOf[_from] || _value > allowance[_from][msg.sender] || (balanceOf[_to] + _value) < balanceOf[_to]"
            },
            {
                "Expr": "balanceOf[_from] -= _value",
                "WPState": "['balanceOf']",
                "Trapdoor": "_value > balanceOf[_from] || _value > allowance[_from][msg.sender] || (balanceOf[_to] + _value) < balanceOf[_to]"
            },
            {
                "Expr": "allowance[_from][msg.sender] -= _value",
                "WPState": "['allowance']",
                "Trapdoor": "_value > balanceOf[_from] || _value > allowance[_from][msg.sender] || (balanceOf[_to] + _value) < balanceOf[_to]"
            }
        ],
        "constructor": [
            {
                "Expr": "balanceOf[msg.sender] = totalSupply",
                "WPState": "['balanceOf']",
                "Trapdoor": "constructor"
            }
        ]
    },
