        "addBotToBlackList(address)": [
            {
                "Expr": "_isBlackListedBot[account] = true",
                "W_TDS": "['_isBlackListedBot']",
                "Trapdoor": "Modifier"
            }
        ],
        "removeBotFromBlackList(address)": [
            {
                "Expr": "_isBlackListedBot[account] = false",
                "W_TDS": "['_isBlackListedBot']",
                "Trapdoor": "Modifier"
            }
        ],
        "setDevFeeDisabled(bool)": [
            {
                "Expr": "swapAndLiquifyEnabled = _devFeeEnabled",
                "W_TDS": "['swapAndLiquifyEnabled']",
                "Trapdoor": "require(bool,string)(msg.sender == _devWalletAddress,Only Dev Address can disable dev fee)"
            }
        ],
        "constructor": [
            {
                "Expr": "_devWalletAddress = devWalletAddress",
                "W_TDS": "['_devWalletAddress']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDPW": {},
    "FLAG": true
