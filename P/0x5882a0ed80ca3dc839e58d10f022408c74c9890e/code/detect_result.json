{
    "DT": {
        "_transfer(address,address,uint256)": [
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "block.number <= launchBlock + 1 && from == uniswapV2Pair && to != address(uniswapV2Router) && to != address(this)"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "require(bool,string)(! bots[from] && ! bots[to],TOKEN: Your account is blacklisted!)"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "to != uniswapV2Pair"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "canSwap && ! inSwap && from != uniswapV2Pair && swapEnabled && ! _isExcludedFromFee[from] && ! _isExcludedFromFee[to]"
            }
        ]
    },
    "DPW": {},
    "IDT": {
        "setTrading(bool)": [
            {
                "Expr": "tradingOpen = _tradingOpen",
                "W_TDS": "['tradingOpen']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "launchBlock = block.number",
                "W_TDS": "['launchBlock']",
                "Trapdoor": "Modifier"
            }
        ],
        "blockBots(address[])": [
            {
                "Expr": "bots[bots_[i]] = true",
                "W_TDS": "['bots']",
                "Trapdoor": "Modifier"
            }
        ],
        "unblockBot(address)": [
            {
                "Expr": "bots[notbot] = false",
                "W_TDS": "['bots']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMinSwapTokensThreshold(uint256)": [
            {
                "Expr": "_swapTokensAtAmount = swapTokensAtAmount",
                "W_TDS": "['_swapTokensAtAmount']",
                "Trapdoor": "Modifier"
            }
        ],
        "toggleSwap(bool)": [
            {
                "Expr": "swapEnabled = _swapEnabled",
                "W_TDS": "['swapEnabled']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMaxTxnAmount(uint256)": [
            {
                "Expr": "_maxTxAmount = maxTxAmount",
                "W_TDS": "['_maxTxAmount']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMaxWalletSize(uint256)": [
            {
                "Expr": "_maxWalletSize = maxWalletSize",
                "W_TDS": "['_maxWalletSize']",
                "Trapdoor": "Modifier"
            }
        ],
        "excludeMultipleAccountsFromFees(address[],bool)": [
            {
                "Expr": "_isExcludedFromFee[accounts[i]] = excluded",
                "W_TDS": "['_isExcludedFromFee']",
                "Trapdoor": "Modifier"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "bots[to] = true",
                "W_TDS": "['bots']",
                "Trapdoor": "require(bool,string)(! bots[from] && ! bots[to],TOKEN: Your account is blacklisted!)"
            },
            {
                "Expr": "bots[to] = true",
                "W_TDS": "['bots']",
                "Trapdoor": "block.number <= launchBlock + 1 && from == uniswapV2Pair && to != address(uniswapV2Router) && to != address(this)"
            }
        ],
        "constructor": [
            {
                "Expr": "uniswapV2Pair = IUniswapV2Factory(_uniswapV2Router.factory()).createPair(address(this),_uniswapV2Router.WETH())",
                "W_TDS": "['uniswapV2Pair']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDPW": {},
    "FLAG": true
