{
    "DT": {
        "startTrade()": [
            {
                "Expr": "uniswapV2Router.addLiquidityETH{value: address(this).balance}(address(this),balanceOf(address(this)),0,0,owner(),block.timestamp)",
                "Trapdoor": "Modifier"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "burnToken(burnAmount)",
                "Trapdoor": "from == uniswapV2Pair && to != address(uniswapV2Router) && ! _isExcludedFromFee[to]"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "from == uniswapV2Pair && to != address(uniswapV2Router) && ! _isExcludedFromFee[to]"
            }
        ]
    },
    "DPW": {},
    "IDT": {
        "initPair()": [
            {
                "Expr": "uniswapV2Router = _uniswapV2Router",
                "W_TDS": "['uniswapV2Router']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "uniswapV2Pair = IUniswapV2Factory(_uniswapV2Router.factory()).createPair(address(this),_uniswapV2Router.WETH())",
                "W_TDS": "['uniswapV2Pair']",
                "Trapdoor": "Modifier"
            }
        ],
        "startTrade()": [
            {
                "Expr": "_launchedAt = block.timestamp",
                "W_TDS": "['_launchedAt']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_tradingOpen = true",
                "W_TDS": "['_tradingOpen']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_maxHeldTokens = 20000000 * 10 ** 9",
                "W_TDS": "['_maxHeldTokens']",
                "Trapdoor": "Modifier"
            }
        ],
        "setFeeRate(uint256)": [
            {
                "Expr": "_feeRate = rate",
                "W_TDS": "['_feeRate']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_feeRate = rate",
                "W_TDS": "['_feeRate']",
                "Trapdoor": "require(bool)(_msgSender() == _FeeCollectionADD)"
            }
        ],
        "toggleImpactFee(bool)": [
            {
                "Expr": "_useImpactFeeSetter = onoff",
                "W_TDS": "['_useImpactFeeSetter']",
                "Trapdoor": "Modifier"
            }
        ],
        "setBots(address[])": [
            {
                "Expr": "_isBot[bots_[i]] = true",
                "W_TDS": "['_isBot']",
                "Trapdoor": "Modifier"
            }
        ],
        "updateTaxAdd(address)": [
            {
                "Expr": "_FeeCollectionADD = address(newAddress)",
                "W_TDS": "['_FeeCollectionADD']",
                "Trapdoor": "require(bool)(_msgSender() == _FeeCollectionADD)"
            }
        ],
        "constructor": [
            {
                "Expr": "_isExcludedFromFee[address(this)] = true",
                "W_TDS": "['_isExcludedFromFee']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDPW": {},
    "FLAG": true
}