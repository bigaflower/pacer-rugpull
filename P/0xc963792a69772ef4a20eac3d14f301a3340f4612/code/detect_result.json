{
    "DT": {
        "buyBackTokens(uint256)": [
            {
                "Expr": "uniswapV2Router.swapExactETHForTokensSupportingFeeOnTransferTokens{value: ETHAmountInWei}(0,path,address(0xdead),block.timestamp)",
                "Trapdoor": "Modifier"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "swapAndLiquify(contractTokenBalance)",
                "Trapdoor": "overMinimumTokenBalance && ! inSwapAndLiquify && ! isMarketPair[sender]"
            }
        ],
        "swapAndLiquify(uint256)": [
            {
                "Expr": "addLiquidity(tokensForLP,amountLiquidity)",
                "Trapdoor": "totalFee = _totalDistributionShares.sub(_liquiditySharePercentage.div(2))"
            },
            {
                "Expr": "transferToAddressETH(operationsWallet,amountOperations)",
                "Trapdoor": "totalFee = _totalDistributionShares.sub(_liquiditySharePercentage.div(2))"
            },
            {
                "Expr": "addLiquidity(tokensForLP,amountLiquidity)",
                "Trapdoor": "tokensForLP = swapAmount.mul(_liquiditySharePercentage).div(_totalDistributionShares).div(2)"
            }
        ]
    },
    "DPW": {
        "constructor": [
            {
                "Expr": "_allowances[address(this)][address(uniswapV2Router)] = _totalSupply",
                "WPState": "['_allowances']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDT": {
        "setMarketPairStatus(address,bool)": [
            {
                "Expr": "isMarketPair[account] = newValue",
                "W_TDS": "['isMarketPair']",
                "Trapdoor": "Modifier"
            }
        ],
        "setDistributionSettings(uint256,uint256)": [
            {
                "Expr": "_totalDistributionShares = _liquiditySharePercentage + _operationsSharePercentage",
                "W_TDS": "['_totalDistributionShares']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_liquiditySharePercentage = newLiquidityShare",
                "W_TDS": "['_liquiditySharePercentage']",
                "Trapdoor": "Modifier"
            }
        ],
        "setNumTokensBeforeSwap(uint256)": [
            {
                "Expr": "minimumTokensBeforeSwap = newLimit",
                "W_TDS": "['minimumTokensBeforeSwap']",
                "Trapdoor": "Modifier"
            }
        ],
        "updateOperationsWallet(address)": [
            {
                "Expr": "operationsWallet = address(newAddress)",
                "W_TDS": "['operationsWallet']",
                "Trapdoor": "Modifier"
            }
        ],
        "changeRouterAddress(address)": [
            {
                "Expr": "uniswapV2Router = _uniswapV2Router",
                "W_TDS": "['uniswapV2Router']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "isMarketPair[address(uniswapPair)] = true",
                "W_TDS": "['isMarketPair']",
                "Trapdoor": "Modifier"
            }
        ],
        "setTrading()": [
            {
                "Expr": "tradingOpen = true",
                "W_TDS": "['tradingOpen']",
                "Trapdoor": "Modifier"
            }
        ],
        "constructor": [
            {
                "Expr": "isMarketPair[address(uniswapPair)] = true",
                "W_TDS": "['isMarketPair']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDPW": {
        "changeRouterAddress(address)": [
            {
                "Expr": "uniswapV2Router = _uniswapV2Router",
                "W_PSWDS": "['uniswapV2Router']",
                "Trapdoor": "Modifier"
            }
        ],
        "constructor": [
            {
                "Expr": "uniswapV2Router = _uniswapV2Router",
                "W_PSWDS": "['uniswapV2Router']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "FLAG": true
}