{
    "DT": {
        "_transfer(address,address,uint256)": [
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "from != owner() && to != owner() && ! preTrader[from] && ! preTrader[to]"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "to != uniswapV2Pair"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "require(bool,string)(preTrader[from],TOKEN: This account cannot send tokens until trading is enabled)"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "canSwap && ! inSwap && from != uniswapV2Pair && swapEnabled && ! _isExcludedFromFee[from] && ! _isExcludedFromFee[to]"
            }
        ]
    },
    "DPW": {},
    "IDT": {
        "setTrading(bool)": [
            {
                "Expr": "tradingOpen = _tradingOpen",
                "W_TDS": "['tradingOpen']",
                "Trapdoor": "Modifier"
            }
        ],
        "blockBots(address[])": [
            {
                "Expr": "bots[bots_[i]] = true",
                "W_TDS": "['bots']",
                "Trapdoor": "Modifier"
            }
        ],
        "unblockBot(address)": [
            {
                "Expr": "bots[notbot] = false",
                "W_TDS": "['bots']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMinSwapTokensThreshold(uint256)": [
            {
                "Expr": "_swapTokensAtAmount = swapTokensAtAmount",
                "W_TDS": "['_swapTokensAtAmount']",
                "Trapdoor": "Modifier"
            }
        ],
        "toggleSwap(bool)": [
            {
                "Expr": "swapEnabled = _swapEnabled",
                "W_TDS": "['swapEnabled']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMaxTxnAmount(uint256)": [
            {
                "Expr": "_maxTxAmount = maxTxAmount",
                "W_TDS": "['_maxTxAmount']",
                "Trapdoor": "Modifier"
            }
        ],
        "setMaxWalletSize(uint256)": [
            {
                "Expr": "_maxWalletSize = maxWalletSize",
                "W_TDS": "['_maxWalletSize']",
                "Trapdoor": "Modifier"
            }
        ],
        "excludeMultipleAccountsFromFees(address[],bool)": [
            {
                "Expr": "_isExcludedFromFee[accounts[i]] = excluded",
                "W_TDS": "['_isExcludedFromFee']",
                "Trapdoor": "Modifier"
            }
        ],
        "allowPreTrading(address,bool)": [
            {
                "Expr": "preTrader[account] = allowed",
                "W_TDS": "['preTrader']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "preTrader[account] = allowed",
                "W_TDS": "['preTrader']",
                "Trapdoor": "require(bool,string)(preTrader[account] != allowed,TOKEN: Already enabled.)"
            }
        ],
        "constructor": [
            {
                "Expr": "_isExcludedFromFee[_developmentAddress] = true",
                "W_TDS": "['_isExcludedFromFee']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDPW": {},
    "FLAG": true
}