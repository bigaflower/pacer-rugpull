// File: DiskMint1155.sol


pragma solidity ^0.8.20;






/**
 * @title DiskMint1155
 * @notice ERC-1155 NFT with 3-phase whitelist minting, per-wallet allocation,
 *         block hash randomization, burn-for-reroll, and EIP-2981 royalties
 * @dev Supply: Type 1 = 2950, Type 2 = 40, Type 3 = 10
 */
contract DiskMint1155 is ERC1155, ERC2981, Ownable, ReentrancyGuard {
    
    // ============ Constants ============
    
    uint256 public constant MAX_SUPPLY = 3000;
    uint256 public constant DISK_TYPE_1 = 0;  // 2950 supply
    uint256 public constant DISK_TYPE_2 = 1;  // 40 supply
    uint256 public constant DISK_TYPE_3 = 2;  // 10 supply
    
    uint256 public constant MAX_TYPE_1 = 2950;
    uint256 public constant MAX_TYPE_2 = 40;
    uint256 public constant MAX_TYPE_3 = 10;
    
    uint256 public constant PUBLIC_MAX_PER_TX = 10;
    
    // ============ State Variables ============
    
    // Mint price in wei (~$2 USD, adjust as needed)
    uint256 public mintPrice = 0.0006 ether;
    
    // Supply tracking per token ID
    mapping(uint256 => uint256) public tokenSupply;
    uint256 public totalMinted;
    
    // Total burned (for tracking)
    mapping(uint256 => uint256) public tokenBurned;
    uint256 public totalBurned;
    
    // Phase configuration
    // Phase 0: Friends & Family (3 hours)
    // Phase 1: FCFS (1 hour)
    // Phase 2: Public (open)
    struct Phase {
        bytes32 merkleRoot;
        uint256 startTime;
        uint256 endTime;
        bool active;
    }
    
    // Phases 0-2 (Friends & Family, FCFS, Public handled separately)
    mapping(uint256 => Phase) public phases;
    
    // Track mints per wallet per phase (for whitelist phases)
    mapping(uint256 => mapping(address => uint256)) public phaseWhitelistMinted;
    
    // Public mint state
    bool public publicMintActive;
    
    // Metadata URI
    string private _baseURI;

    // Timelock configuration
    uint256 public constant TIMELOCK_DURATION = 24 hours;
    bool public mintingStarted;

    struct PendingPriceChange {
        uint256 newPrice;
        uint256 executeAfter;
    }
    PendingPriceChange public pendingPriceChange;

    struct PendingPhaseChange {
        bytes32 merkleRoot;
        uint256 startTime;
        uint256 endTime;
        bool active;
        uint256 executeAfter;
    }
    mapping(uint256 => PendingPhaseChange) public pendingPhaseChanges;

    // ============ Events ============
    
    event Minted(address indexed minter, uint256 indexed tokenId, uint256 amount);
    event PhaseUpdated(uint256 indexed phaseId, bytes32 merkleRoot, uint256 startTime, uint256 endTime);
    event PublicMintToggled(bool active);
    event PriceUpdated(uint256 newPrice);
    event PriceChangeQueued(uint256 newPrice, uint256 executeAfter);
    event PriceChangeCancelled();
    event PhaseChangeQueued(uint256 indexed phaseId, uint256 executeAfter);
    event PhaseChangeCancelled(uint256 indexed phaseId);

    // Reroll event - frontend/backend listens for this
    event DiskBurnedForReroll(
        address indexed burner,
        uint256 indexed diskType,
        uint256 amount,
        uint256 indexed targetTokenId  // The token ID in the other collection to reroll
    );
    
    // ============ Constructor ============
    
    /**
     * @param baseURI Base URI for token metadata
     * @param royaltyReceiver Address to receive royalties
     * @param royaltyBps Royalty percentage in basis points (500 = 5%)
     */
    constructor(
        string memory baseURI,
        address royaltyReceiver,
        uint96 royaltyBps
    ) ERC1155(baseURI) Ownable(msg.sender) {
        _baseURI = baseURI;
        _setDefaultRoyalty(royaltyReceiver, royaltyBps);
    }
    
    // ============ Minting Functions ============
    
    /**
     * @notice Whitelist mint with Merkle proof (Phases 0-1: Friends & Family, FCFS)
     * @param phaseId Phase number (0 = Friends & Family, 1 = FCFS)
     * @param allocation Max mints allocated to this wallet
     * @param amount Number of tokens to mint
     * @param merkleProof Merkle proof for verification
     */
    function whitelistMint(
        uint256 phaseId,
        uint256 allocation,
        uint256 amount,
        bytes32[] calldata merkleProof
    ) external payable nonReentrant {
        require(phaseId < 2, "Invalid phase"); // Only phases 0 and 1 for whitelist
        Phase storage phase = phases[phaseId];
        
        require(phase.active, "Phase not active");
        require(block.timestamp >= phase.startTime, "Phase not started");
        require(block.timestamp <= phase.endTime, "Phase ended");
        
        // Verify Merkle proof: leaf = keccak256(wallet, phaseId, allocation)
        bytes32 leaf = keccak256(abi.encodePacked(msg.sender, phaseId, allocation));
        require(MerkleProof.verify(merkleProof, phase.merkleRoot, leaf), "Invalid proof");
        
        // Check allocation (per-phase tracking)
        require(phaseWhitelistMinted[phaseId][msg.sender] + amount <= allocation, "Exceeds allocation");
        require(msg.value >= mintPrice * amount, "Insufficient payment");
        require(totalMinted + amount <= MAX_SUPPLY, "Exceeds max supply");

        // Mark minting as started for timelock enforcement
        if (!mintingStarted) mintingStarted = true;

        // Update state before minting
        phaseWhitelistMinted[phaseId][msg.sender] += amount;
        
        // Mint with randomization
        _mintWithRandomization(msg.sender, amount);
    }
    
    /**
     * @notice Public mint (10 per transaction, unlimited transactions)
     * @dev Auto-activates after Phase 1 ends, or can be manually enabled
     * @param amount Number of tokens to mint (max 5)
     */
    function publicMint(uint256 amount) external payable nonReentrant {
        require(_isPublicMintOpen(), "Public mint not active");
        require(amount > 0 && amount <= PUBLIC_MAX_PER_TX, "Invalid amount");
        require(msg.value >= mintPrice * amount, "Insufficient payment");
        require(totalMinted + amount <= MAX_SUPPLY, "Exceeds max supply");
        
        _mintWithRandomization(msg.sender, amount);
    }

    function ownerMint(address to, uint256 amount) external onlyOwner nonReentrant {
        require(!mintingStarted, "Minting has started");
        require(amount > 0, "Amount must be > 0");
        require(totalMinted + amount <= MAX_SUPPLY, "Exceeds max supply");

        _mintWithRandomization(to, amount);
    }

    /**
     * @dev Check if public mint is open (manual override OR auto after Phase 1)
     */
    function _isPublicMintOpen() internal view returns (bool) {
        // Manual override takes precedence
        if (publicMintActive) return true;
        
        // Auto-open after Phase 1 ends (if Phase 1 was configured)
        Phase storage phase1 = phases[1];
        if (phase1.endTime > 0 && block.timestamp > phase1.endTime) {
            return true;
        }
        
        return false;
    }
    
    /**
     * @dev Internal function to mint with block hash based randomization
     * @param to Recipient address
     * @param amount Number of tokens to mint
     */
    function _mintWithRandomization(address to, uint256 amount) internal {
        for (uint256 i = 0; i < amount; i++) {
            // Generate pseudo-random number using block data
            uint256 randomSeed = uint256(
                keccak256(
                    abi.encodePacked(
                        blockhash(block.number - 1),
                        block.timestamp,
                        msg.sender,
                        totalMinted,
                        i
                    )
                )
            );
            
            uint256 tokenId = _determineTokenId(randomSeed);
            
            // Mint the token
            _mint(to, tokenId, 1, "");
            tokenSupply[tokenId]++;
            totalMinted++;
            
            emit Minted(to, tokenId, 1);
        }
    }
    
    /**
     * @dev Determine token ID based on random seed and remaining supply
     * @param randomSeed Random number for selection
     * @return tokenId The selected token ID
     */
    function _determineTokenId(uint256 randomSeed) internal view returns (uint256) {
        // Calculate remaining supply for each type
        uint256 remainingType1 = MAX_TYPE_1 > tokenSupply[DISK_TYPE_1] 
            ? MAX_TYPE_1 - tokenSupply[DISK_TYPE_1] : 0;
        uint256 remainingType2 = MAX_TYPE_2 > tokenSupply[DISK_TYPE_2] 
            ? MAX_TYPE_2 - tokenSupply[DISK_TYPE_2] : 0;
        uint256 remainingType3 = MAX_TYPE_3 > tokenSupply[DISK_TYPE_3] 
            ? MAX_TYPE_3 - tokenSupply[DISK_TYPE_3] : 0;
        
        uint256 totalRemaining = remainingType1 + remainingType2 + remainingType3;
        require(totalRemaining > 0, "No supply remaining");
        
        // Weighted random selection based on remaining supply
        // Initial probabilities: Type1 ~98.3%, Type2 ~1.3%, Type3 ~0.3%
        uint256 roll = randomSeed % totalRemaining;
        
        if (roll < remainingType1) {
            return DISK_TYPE_1;
        } else if (roll < remainingType1 + remainingType2) {
            return DISK_TYPE_2;
        } else {
            return DISK_TYPE_3;
        }
    }
    
    // ============ Burn / Reroll Functions ============
    
    /**
     * @notice Burn disk(s) to initiate a reroll on another collection
     * @dev Frontend listens for DiskBurnedForReroll event to process off-chain
     * @param diskType The disk type to burn (0, 1, or 2)
     * @param amount Number of disks to burn
     * @param targetTokenId The token ID in the target collection to reroll
     */
    function burnForReroll(
        uint256 diskType,
        uint256 amount,
        uint256 targetTokenId
    ) external nonReentrant {
        require(diskType <= DISK_TYPE_3, "Invalid disk type");
        require(amount > 0, "Amount must be > 0");
        require(balanceOf(msg.sender, diskType) >= amount, "Insufficient disk balance");
        
        // Burn the disks
        _burn(msg.sender, diskType, amount);
        
        // Update burn tracking
        tokenBurned[diskType] += amount;
        totalBurned += amount;
        
        // Emit event for frontend/backend to process reroll
        emit DiskBurnedForReroll(msg.sender, diskType, amount, targetTokenId);
    }
    
    /**
     * @notice Burn disk(s) without reroll (standard burn)
     * @param diskType The disk type to burn
     * @param amount Number of disks to burn
     */
    function burn(uint256 diskType, uint256 amount) external {
        require(diskType <= DISK_TYPE_3, "Invalid disk type");
        require(amount > 0, "Amount must be > 0");
        require(balanceOf(msg.sender, diskType) >= amount, "Insufficient disk balance");
        
        _burn(msg.sender, diskType, amount);
        
        tokenBurned[diskType] += amount;
        totalBurned += amount;
    }
    
    /**
     * @notice Batch burn multiple disk types for a single reroll
     * @param diskTypes Array of disk types to burn
     * @param amounts Array of amounts for each type
     * @param targetTokenId The token ID in the target collection to reroll
     */
    function batchBurnForReroll(
        uint256[] calldata diskTypes,
        uint256[] calldata amounts,
        uint256 targetTokenId
    ) external nonReentrant {
        require(diskTypes.length == amounts.length, "Array length mismatch");
        require(diskTypes.length > 0, "Empty arrays");
        
        for (uint256 i = 0; i < diskTypes.length; i++) {
            require(diskTypes[i] <= DISK_TYPE_3, "Invalid disk type");
            require(amounts[i] > 0, "Amount must be > 0");
            require(balanceOf(msg.sender, diskTypes[i]) >= amounts[i], "Insufficient disk balance");
            
            _burn(msg.sender, diskTypes[i], amounts[i]);
            
            tokenBurned[diskTypes[i]] += amounts[i];
            totalBurned += amounts[i];
            
            emit DiskBurnedForReroll(msg.sender, diskTypes[i], amounts[i], targetTokenId);
        }
    }
    
    // ============ Admin Functions ============
    
    /**
     * @notice Set phase configuration
     * @param phaseId Phase number (0 = Friends & Family, 1 = FCFS)
     * @param merkleRoot Merkle root for whitelist verification
     * @param startTime Unix timestamp for phase start
     * @param endTime Unix timestamp for phase end
     * @param active Whether phase is active
     */
    function setPhase(
        uint256 phaseId,
        bytes32 merkleRoot,
        uint256 startTime,
        uint256 endTime,
        bool active
    ) external onlyOwner {
        require(!mintingStarted, "Use queueSetPhase");
        require(phaseId < 2, "Invalid phase");
        require(endTime > startTime, "Invalid time range");
        
        phases[phaseId] = Phase({
            merkleRoot: merkleRoot,
            startTime: startTime,
            endTime: endTime,
            active: active
        });
        
        emit PhaseUpdated(phaseId, merkleRoot, startTime, endTime);
    }

    function queueSetPhase(
        uint256 phaseId,
        bytes32 merkleRoot,
        uint256 startTime,
        uint256 endTime,
        bool active
    ) external onlyOwner {
        require(mintingStarted, "Minting not started, use setPhase");
        require(phaseId < 2, "Invalid phase");
        require(endTime > startTime, "Invalid time range");

        pendingPhaseChanges[phaseId] = PendingPhaseChange({
            merkleRoot: merkleRoot,
            startTime: startTime,
            endTime: endTime,
            active: active,
            executeAfter: block.timestamp + TIMELOCK_DURATION
        });
        emit PhaseChangeQueued(phaseId, block.timestamp + TIMELOCK_DURATION);
    }

    function executeSetPhase(uint256 phaseId) external onlyOwner {
        PendingPhaseChange storage pending = pendingPhaseChanges[phaseId];
        require(pending.executeAfter > 0, "No pending change");
        require(block.timestamp >= pending.executeAfter, "Timelock not expired");

        phases[phaseId] = Phase({
            merkleRoot: pending.merkleRoot,
            startTime: pending.startTime,
            endTime: pending.endTime,
            active: pending.active
        });
        emit PhaseUpdated(phaseId, pending.merkleRoot, pending.startTime, pending.endTime);
        delete pendingPhaseChanges[phaseId];
    }

    function cancelSetPhase(uint256 phaseId) external onlyOwner {
        require(pendingPhaseChanges[phaseId].executeAfter > 0, "No pending change");
        delete pendingPhaseChanges[phaseId];
        emit PhaseChangeCancelled(phaseId);
    }

    /**
     * @notice Manually toggle public mint (override for auto-activation)
     * @dev Public mint auto-opens after Phase 1 ends; use this to open early or close
     * @param active Whether public mint is active
     */
    function setPublicMintActive(bool active) external onlyOwner {
        publicMintActive = active;
        emit PublicMintToggled(active);
    }
    
    /**
     * @notice Update mint price
     * @param newPrice New price in wei
     */
    function setMintPrice(uint256 newPrice) external onlyOwner {
        require(!mintingStarted, "Use queueSetMintPrice");
        mintPrice = newPrice;
        emit PriceUpdated(newPrice);
    }

    function queueSetMintPrice(uint256 newPrice) external onlyOwner {
        require(mintingStarted, "Minting not started, use setMintPrice");
        pendingPriceChange = PendingPriceChange({
            newPrice: newPrice,
            executeAfter: block.timestamp + TIMELOCK_DURATION
        });
        emit PriceChangeQueued(newPrice, block.timestamp + TIMELOCK_DURATION);
    }

    function executeSetMintPrice() external onlyOwner {
        require(pendingPriceChange.executeAfter > 0, "No pending change");
        require(block.timestamp >= pendingPriceChange.executeAfter, "Timelock not expired");
        mintPrice = pendingPriceChange.newPrice;
        emit PriceUpdated(pendingPriceChange.newPrice);
        delete pendingPriceChange;
    }

    function cancelSetMintPrice() external onlyOwner {
        require(pendingPriceChange.executeAfter > 0, "No pending change");
        delete pendingPriceChange;
        emit PriceChangeCancelled();
    }

    /**
     * @notice Update base URI for metadata
     * @param newBaseURI New base URI
     */
    function setURI(string memory newBaseURI) external onlyOwner {
        _baseURI = newBaseURI;
    }
    
    /**
     * @notice Update default royalty for all tokens
     * @param receiver Address to receive royalties
     * @param feeNumerator Royalty in basis points (500 = 5%)
     */
    function setDefaultRoyalty(address receiver, uint96 feeNumerator) external onlyOwner {
        _setDefaultRoyalty(receiver, feeNumerator);
    }
    
    /**
     * @notice Remove default royalty
     */
    function deleteDefaultRoyalty() external onlyOwner {
        _deleteDefaultRoyalty();
    }
    
    /**
     * @notice Withdraw contract balance
     */
    function withdraw() external onlyOwner {
        uint256 balance = address(this).balance;
        require(balance > 0, "No balance to withdraw");
        
        (bool success, ) = payable(owner()).call{value: balance}("");
        require(success, "Withdrawal failed");
    }
    
    // ============ View Functions ============
    
    /**
     * @notice Get URI for a token ID
     * @param tokenId Token ID
     * @return Token metadata URI
     */
    function uri(uint256 tokenId) public view override returns (string memory) {
        require(tokenId <= DISK_TYPE_3, "Invalid token ID");
        return string(abi.encodePacked(_baseURI, _toString(tokenId), ".json"));
    }
    
    /**
     * @notice Get phase info
     * @param phaseId Phase number (0-1)
     * @return merkleRoot Merkle root for whitelist verification
     * @return startTime Phase start timestamp
     * @return endTime Phase end timestamp
     * @return active Whether phase is active
     */
    function getPhase(uint256 phaseId) external view returns (
        bytes32 merkleRoot,
        uint256 startTime,
        uint256 endTime,
        bool active
    ) {
        Phase storage phase = phases[phaseId];
        return (phase.merkleRoot, phase.startTime, phase.endTime, phase.active);
    }
    
    /**
     * @notice Get remaining supply for each disk type
     * @return type1 Remaining Type 1 supply
     * @return type2 Remaining Type 2 supply
     * @return type3 Remaining Type 3 supply
     */
    function getRemainingSupply() external view returns (
        uint256 type1,
        uint256 type2,
        uint256 type3
    ) {
        return (
            MAX_TYPE_1 - tokenSupply[DISK_TYPE_1],
            MAX_TYPE_2 - tokenSupply[DISK_TYPE_2],
            MAX_TYPE_3 - tokenSupply[DISK_TYPE_3]
        );
    }
    
    /**
     * @notice Get burn statistics
     * @return type1Burned Type 1 burned count
     * @return type2Burned Type 2 burned count
     * @return type3Burned Type 3 burned count
     * @return totalBurnedCount Total burned across all types
     */
    function getBurnStats() external view returns (
        uint256 type1Burned,
        uint256 type2Burned,
        uint256 type3Burned,
        uint256 totalBurnedCount
    ) {
        return (
            tokenBurned[DISK_TYPE_1],
            tokenBurned[DISK_TYPE_2],
            tokenBurned[DISK_TYPE_3],
            totalBurned
        );
    }
    
    /**
     * @notice Get current circulating supply (minted - burned)
     * @return type1 Type 1 circulating count
     * @return type2 Type 2 circulating count
     * @return type3 Type 3 circulating count
     */
    function getCirculatingSupply() external view returns (
        uint256 type1,
        uint256 type2,
        uint256 type3
    ) {
        return (
            tokenSupply[DISK_TYPE_1] - tokenBurned[DISK_TYPE_1],
            tokenSupply[DISK_TYPE_2] - tokenBurned[DISK_TYPE_2],
            tokenSupply[DISK_TYPE_3] - tokenBurned[DISK_TYPE_3]
        );
    }
    
    /**
     * @notice Check if address can mint in a phase
     * @param wallet Address to check
     * @param phaseId Phase number
     * @param allocation Allocated amount
     * @param merkleProof Merkle proof
     * @return canMint Whether the wallet can mint
     * @return remainingAllocation Remaining allocation for the wallet
     */
    function canMintWhitelist(
        address wallet,
        uint256 phaseId,
        uint256 allocation,
        bytes32[] calldata merkleProof
    ) external view returns (bool canMint, uint256 remainingAllocation) {
        if (phaseId >= 2) return (false, 0);
        
        Phase storage phase = phases[phaseId];
        if (!phase.active) return (false, 0);
        if (block.timestamp < phase.startTime || block.timestamp > phase.endTime) return (false, 0);
        
        bytes32 leaf = keccak256(abi.encodePacked(wallet, phaseId, allocation));
        if (!MerkleProof.verify(merkleProof, phase.merkleRoot, leaf)) return (false, 0);

        uint256 minted = phaseWhitelistMinted[phaseId][wallet];
        if (minted >= allocation) return (false, 0);

        return (true, allocation - minted);
    }
    
    /**
     * @notice Check if public mint is currently open
     * @return True if public mint is available
     */
    function isPublicMintOpen() external view returns (bool) {
        return _isPublicMintOpen();
    }
    
    /**
     * @notice Get current mint phase status
     * @return phase0Active Whether Phase 0 is active
     * @return phase1Active Whether Phase 1 is active
     * @return publicActive Whether public mint is active
     * @return currentPhase Current phase number (-1 if none)
     */
    function getMintStatus() external view returns (
        bool phase0Active,
        bool phase1Active,
        bool publicActive,
        int256 currentPhase
    ) {
        phase0Active = phases[0].active && 
            block.timestamp >= phases[0].startTime && 
            block.timestamp <= phases[0].endTime;
            
        phase1Active = phases[1].active && 
            block.timestamp >= phases[1].startTime && 
            block.timestamp <= phases[1].endTime;
            
        publicActive = _isPublicMintOpen();
        
        if (phase0Active) {
            currentPhase = 0;
        } else if (phase1Active) {
            currentPhase = 1;
        } else if (publicActive) {
            currentPhase = 2;
        } else {
            currentPhase = -1;
        }
    }
    
    // ============ Internal Helpers ============
    
    function _toString(uint256 value) internal pure returns (string memory) {
        if (value == 0) return "0";
        uint256 temp = value;
        uint256 digits;
        while (temp != 0) {
            digits++;
            temp /= 10;
        }
        bytes memory buffer = new bytes(digits);
        while (value != 0) {
            digits -= 1;
            buffer[digits] = bytes1(uint8(48 + uint256(value % 10)));
            value /= 10;
        }
        return string(buffer);
    }
    
