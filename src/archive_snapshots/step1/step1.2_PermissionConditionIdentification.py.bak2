#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Step 1.2: High-Precision Permission Analysis Engine

Architecture Philosophy:
    "Beyond Pattern Matching - Semantic Understanding Through Program Analysis"

This engine implements a three-stage pipeline to generate structured "Permission Profiles"
for each function, capable of dissecting complex, multi-layered access control logic ranging
from simple onlyOwner checks to sophisticated RBAC and beyond.

Three-Stage Architecture:
    Stage 1: Guard Statement Identification (Scanning Phase)
             → Wide net scan to identify all potential guard statements

    Stage 2: Permission Heuristic Filtering (Brain Phase)
             → AChecker-inspired: Filter conditions that depend on BOTH
               (a) Transient Caller (from step1.1)
               (b) Authorization State (from contract state variables)

    Stage 3: Semantic Parsing & Classification (Translation Phase)
             → Translate code-level conditions into structured, human-readable format
             → Identify patterns: OWNABLE, RBAC, WHITELIST, STATE_CHECK, SIGNATURE, etc.

Output: Permission Profile - A structured JSON object detailing all permission requirements
        for each function, distinguishing true permission checks from business logic.

Author: Chief Static Analysis Architect
"""

import json
import sys
from pathlib import Path
from typing import Dict, Any, List, Optional, Set, Tuple
from dataclasses import dataclass
from enum import Enum

# Add project root to path for imports
try:
    PROJECT_ROOT = Path(__file__).resolve().parents[2]
except NameError:
    PROJECT_ROOT = Path.cwd()

sys.path.insert(0, str(PROJECT_ROOT / 'src'))

from slither.slither import Slither
from slither.core.cfg.node import Node, NodeType
from slither.core.declarations import (
    Modifier, Function, Contract,
    SolidityVariableComposed, SolidityFunction
)
from slither.core.variables.state_variable import StateVariable
from slither.core.variables.local_variable import LocalVariable
from slither.core.expressions import (
    CallExpression, MemberAccess, Identifier,
    BinaryOperation, UnaryOperation, IndexAccess
)
from slither.slithir.operations import (
    Operation, Assignment, Binary, Unary,
    InternalCall, HighLevelCall, LibraryCall,
    Index, Member, SolidityCall
)
from slither.slithir.variables import ReferenceVariable
from slither.analyses.data_dependency.data_dependency import is_dependent
from slither.exceptions import SlitherError

# Import version manager
from utils.version_manager import init_slither
from utils.caller_map_utils import build_caller_context, format_function_key


# ========== Project Path Configuration ==========

def setup_project_paths() -> Tuple[Optional[Path], Optional[Path], Optional[Path]]:
    """
    Auto-discover project root, contracts directory, and output directory

    Returns:
        tuple: (project_root, contracts_dir, output_dir) or (None, None, None) on error
    """
    try:
        # Script is in src/step1/, so root is two levels up
        project_root = Path(__file__).resolve().parents[2]

        contracts_dir = project_root / "contracts"
        output_dir = project_root / "output"

        if not contracts_dir.exists():
            print(f"❌ Error: 'contracts' directory not found in {project_root}.")
            return None, None, None

        output_dir.mkdir(parents=True, exist_ok=True)
        return project_root, contracts_dir, output_dir
    except IndexError:
        print("❌ Error: Cannot determine project root. Ensure script is in 'src/step1/' directory.")
        return None, None, None


# ========== Load Step 1.1 Results (Transient Caller Map) ==========

def load_caller_analysis(contract_name: str, output_dir: Path) -> Tuple[Dict[str, Any], Set[str]]:
    """
    Load transient caller analysis from step1.1

    Args:
        contract_name: Name of the contract
        output_dir: Base output directory

    Returns:
        tuple: (caller_map, persistent_roles)
    """
    source_file = output_dir / contract_name / "step1" / "step1.1_caller_source.json"

    if not source_file.exists():
        print(f"  ⚠️  Warning: step1.1 output not found: {source_file.name}")
        return {}, set()

    try:
        with open(source_file, "r", encoding="utf-8") as f:
            data = json.load(f)
    except json.JSONDecodeError:
        print(f"  ⚠️  Warning: Cannot parse {source_file.name}")
        return {}, set()

    # Navigate the structure: {contract_name: {actual_contract: {persistent_roles, transient_caller_analysis}}}
    contract_data = data.get(contract_name, {})

    caller_context: Dict[str, Any] = {}
    persistent_roles = set()

    for sub_contract_name, analysis in contract_data.items():
        if not isinstance(analysis, dict):
            continue

        # Extract persistent roles
        roles = analysis.get('persistent_roles', [])
        if isinstance(roles, list):
            persistent_roles.update(roles)

        # Extract transient caller map
        # Nothing else here; caller context is built once after the loop
        pass

    if contract_data:
        caller_context = build_caller_context({contract_name: contract_data})
    else:
        caller_context = {
            'global_symbols': {},
            'function_symbols': {},
            'wrapper_functions': set(),
            'tainted_parameters': {},
            'symbol_count': 0,
        }

    return caller_context, persistent_roles


# ========== Data Structures ==========

class ConditionType(Enum):
    """Classification of condition types - Simplified"""
    PERMISSION = "PERMISSION"      # True permission check (caller + state/auth)
    UNKNOWN = "UNKNOWN"            # Other conditions (not tracked)

class PermissionModel(Enum):
    """Access control pattern models"""
    OWNABLE = "OWNABLE"           # Simple owner check
    RBAC = "RBAC"                 # Role-based access control
    WHITELIST = "WHITELIST"       # Whitelist pattern
    BLACKLIST = "BLACKLIST"       # Blacklist pattern
    SIGNATURE = "SIGNATURE"       # Signature-based authorization
    DELEGATED = "DELEGATED"       # Cross-contract authorization
    STATE_LOCK = "STATE_LOCK"     # State-based lock (paused, locked, etc.)
    SELF_AUTH = "SELF_AUTH"       # Self-authorization (caller must be the subject)
    CUSTOM = "CUSTOM"             # Custom permission logic

@dataclass
class ConditionExpression:
    """Represents a single condition expression extracted from code"""
    node: Node
    expression: Any  # Slither expression object
    source_code: str
    line: int
    node_type: str

    # Stage 2 analysis results
    depends_on_caller: bool = False
    depends_on_state: bool = False
    state_variables: List[str] = None
    condition_type: ConditionType = ConditionType.UNKNOWN

    # Stage 3 classification results
    permission_model: Optional[PermissionModel] = None
    parsed_structure: Optional[Dict[str, Any]] = None

    def __post_init__(self):
        if self.state_variables is None:
            self.state_variables = []


# ========== Stage 1: Guard Statement Identification ==========

class GuardStatementScanner:
    """
    Stage 1: Wide-net scan to identify all potential guard statements

    Extracts ALL conditions from:
    - require(C, ...)
    - assert(C)
    - if (C)
    - modifier conditions
    """

    def __init__(self, contract: Contract, sol_path: Path):
        self.contract = contract
        self.sol_path = sol_path

    def scan_function(self, function: Function, include_modifiers: bool = True) -> List[ConditionExpression]:
        """
        Scan a function for all guard statements

        Args:
            function: Function to scan
            include_modifiers: Whether to inline and scan modifiers

        Returns:
            List of ConditionExpression objects
        """
        conditions = []
        visited = set()

        # Scan function body
        conditions.extend(self._scan_unit(function, visited))

        # Scan modifiers if requested
        if include_modifiers:
            for modifier in function.modifiers:
                conditions.extend(self._scan_unit(modifier, visited))

        return conditions

    def _scan_unit(self, unit: Function | Modifier, visited: Set[str]) -> List[ConditionExpression]:
        """Recursively scan a function or modifier for conditions"""
        unit_id = f"{unit.contract.name if hasattr(unit, 'contract') and unit.contract else 'Unknown'}.{unit.name}"

        if unit_id in visited:
            return []
        visited.add(unit_id)

        conditions = []
        processed_lines = set()

        for node in unit.nodes:
            # Check if this node is a guard statement
            if not self._is_guard_node(node):
                continue

            # Avoid duplicate processing
            line = self._get_line_number(node)
            if line in processed_lines:
                continue

            # Extract condition expression
            condition = self._extract_condition(node)
            if condition:
                conditions.append(condition)
                processed_lines.add(line)

        # Recursively scan internal calls
        for call in unit.internal_calls:
            if (hasattr(call, 'function') and call.function and
                hasattr(call.function, 'is_implemented') and call.function.is_implemented):
                conditions.extend(self._scan_unit(call.function, visited))

        return conditions

    def _is_guard_node(self, node: Node) -> bool:
        """Check if node represents a guard statement"""
        node_type_str = str(node.type).upper()

        # Skip end nodes
        if 'END' in node_type_str:
            return False

        # Check for require/assert/revert
        if 'EXPRESSION' in node_type_str:
            if node.expression:
                expr_str = str(node.expression).lower()
                if any(kw in expr_str for kw in ['require', 'assert', 'revert']):
                    return True

        # Check for if statements
        if 'IF' in node_type_str:
            return True

        return False

    def _extract_condition(self, node: Node) -> Optional[ConditionExpression]:
        """
        Extract condition expression from a guard node

        CRITICAL FIX (Task 1): Correctly handle control flow to extract SUCCESS conditions
        - For require(C): condition is C (require reverts when C is false)
        - For if(C) where true branch -> revert: condition is !C
        - For if(C) where false branch -> revert: condition is C
        """
        source_code = self._get_source_code(node)
        line = self._get_line_number(node)

        if not source_code:
            return None

        # Analyze control flow to determine if we need to negate the condition
        actual_condition, actual_source = self._analyze_guard_control_flow(node, source_code)

        return ConditionExpression(
            node=node,
            expression=actual_condition,
            source_code=actual_source[:250],  # Limit length
            line=line,
            node_type=str(node.type)
        )

    def _get_source_code(self, node: Node) -> str:
        """Get source code for a node"""
        if node.expression:
            return str(node.expression)

        if node.source_mapping and node.source_mapping.lines:
            lines = node.source_mapping.lines
            if lines:
                try:
                    with open(self.sol_path, 'r', encoding='utf-8') as f:
                        file_lines = f.readlines()
                        code_lines = file_lines[min(lines)-1 : max(lines)]
                        return ''.join(code_lines).strip()
                except (IOError, IndexError):
                    pass

        return ""

    def _analyze_guard_control_flow(self, node: Node, source_code: str) -> tuple[Any, str]:
        """
        Analyze control flow to extract the SUCCESS condition (Task 1 fix)

        For guard statements, we need to determine what condition allows execution to continue.

        Returns:
            tuple: (corrected_expression, corrected_source_code)
        """
        node_type_str = str(node.type).upper()

        # Case 1: require(C) or assert(C)
        # These revert when condition is FALSE, so condition itself is the success condition
        if 'EXPRESSION' in node_type_str:
            expr_str = str(node.expression).lower() if node.expression else ''
            if 'require' in expr_str or 'assert' in expr_str:
                # Extract the condition from require(C, ...) or assert(C)
                # The condition C is already the success condition
                return (node.expression, source_code)

        # Case 2: if(C) statement
        # Need to check which branch leads to revert
        if 'IF' in node_type_str:
            # Check if true branch or false branch leads to revert
            true_leads_to_revert = self._branch_leads_to_revert(node, branch='true')
            false_leads_to_revert = self._branch_leads_to_revert(node, branch='false')

            if true_leads_to_revert and not false_leads_to_revert:
                # if (C) { revert } else { continue }
                # Success condition is !C
                negated_source = self._negate_condition_str(source_code)
                return (node.expression, negated_source)
            elif false_leads_to_revert and not true_leads_to_revert:
                # if (C) { continue } else { revert }
                # Success condition is C (already correct)
                return (node.expression, source_code)
            # If both or neither lead to revert, keep original

        # Default: return as-is
        return (node.expression, source_code)

    def _branch_leads_to_revert(self, if_node: Node, branch: str) -> bool:
        """
        Check if a branch of an IF statement leads to revert

        Args:
            if_node: The IF node
            branch: 'true' or 'false'

        Returns:
            bool: True if the branch leads to revert
        """
        if not hasattr(if_node, 'sons') or not if_node.sons:
            return False

        # Get the appropriate branch
        # Slither CFG: IF nodes have sons[0] = true branch, sons[1] = false branch (usually)
        if len(if_node.sons) < 2:
            return False

        target_node = if_node.sons[0] if branch == 'true' else if_node.sons[1] if len(if_node.sons) > 1 else None

        if not target_node:
            return False

        # Check if this branch directly or indirectly leads to revert
        return self._node_leads_to_revert(target_node, visited=set(), depth=0, max_depth=10)

    def _node_leads_to_revert(self, node: Node, visited: set, depth: int, max_depth: int) -> bool:
        """
        Recursively check if a node leads to revert (with depth limit)

        Args:
            node: Node to check
            visited: Set of visited node IDs to avoid cycles
            depth: Current recursion depth
            max_depth: Maximum depth to search

        Returns:
            bool: True if node leads to revert
        """
        if depth > max_depth:
            return False

        node_id = id(node)
        if node_id in visited:
            return False
        visited.add(node_id)

        # Check if this node is a revert/throw
        node_type_str = str(node.type).upper()
        if 'THROW' in node_type_str:
            return True

        # Check if expression contains revert
        if node.expression:
            expr_str = str(node.expression).lower()
            if 'revert' in expr_str:
                return True

        # Check sons (successor nodes)
        if hasattr(node, 'sons'):
            for son in node.sons:
                if self._node_leads_to_revert(son, visited, depth + 1, max_depth):
                    return True

        return False

    def _negate_condition_str(self, condition_str: str) -> str:
        """
        Create a negated version of a condition string for display

        Args:
            condition_str: Original condition string

        Returns:
            str: Negated condition string
        """
        condition_str = condition_str.strip()

        # If condition already starts with !, remove it
        if condition_str.startswith('!'):
            # Remove leading ! and any whitespace
            return condition_str[1:].strip()

        # Otherwise, add ! prefix
        # Handle complex conditions by wrapping in parentheses if needed
        if ' ' in condition_str and not condition_str.startswith('('):
            return f"({condition_str})"
        else:
            return f"!{condition_str}"

    def _get_line_number(self, node: Node) -> int:
        """Get line number for a node"""
        if node.source_mapping and node.source_mapping.lines:
            return node.source_mapping.lines[0]
        return -1


# ========== Stage 2: Permission Heuristic Filtering (AChecker-Inspired) ==========

class PermissionHeuristicFilter:
    """
    Stage 2: Apply AChecker methodology to filter true permission checks

    Golden Rule (Source Code Adaptation):
        A condition C is a PERMISSION check if it depends on BOTH:
        (a) A Transient Caller - any symbol from our Caller Map (step1.1)
        (b) An Authorization State - a value read from contract state variables

    For mapping types, apply the sophisticated filter:
        - bool type: Pass (likely permission check)
        - non-bool type: Forward slice - if used in math operations, FAIL (business logic)
    """

    def __init__(self,
                 contract: Contract,
                 caller_context: Dict[str, Any],
                 persistent_roles: Set[str]):
        self.contract = contract
        self.caller_context = caller_context or {}
        self.persistent_roles = persistent_roles
        self.global_symbols = set(
            (self.caller_context.get('global_symbols') or {}).keys()
        )
        self.function_symbols: Dict[str, Dict[str, Any]] = (
            self.caller_context.get('function_symbols') or {}
        )

    def _function_key(self, function: Optional[Function]) -> Optional[str]:
        if not function:
            return None
        contract_name = function.contract.name if function.contract else self.contract.name
        return format_function_key(contract_name, function.full_name)

    def _get_function_caller_symbols(self, function: Optional[Function]) -> Set[str]:
        symbols = set(self.global_symbols)
        func_key = self._function_key(function)
        if func_key and func_key in self.function_symbols:
            symbols.update(self.function_symbols[func_key].keys())
        return symbols

    def filter_conditions(self, conditions: List[ConditionExpression]) -> List[ConditionExpression]:
        """
        Filter conditions to identify permission checks vs business logic

        Args:
            conditions: List of conditions from Stage 1

        Returns:
            Same list with analysis fields populated
        """
        for condition in conditions:
            # Check caller dependency
            condition.depends_on_caller = self._depends_on_caller(condition)

            # Check state dependency
            condition.depends_on_state, condition.state_variables = self._depends_on_state(condition)

            # Classify condition type
            condition.condition_type = self._classify_condition(condition)

        return conditions

    def _depends_on_caller(self, condition: ConditionExpression) -> bool:
        """
        Check if condition depends on transient caller

        Uses backward data flow slice to check if any caller symbol is in dependency
        """
        # Simple approach: check if any caller symbol appears in source code
        source_lower = condition.source_code.lower()
        function = getattr(condition.node, 'function', None)
        caller_symbols = self._get_function_caller_symbols(function)

        for symbol in caller_symbols:
            if symbol in source_lower:
                return True
            symbol_base = symbol.replace('()', '').replace('(', '').replace(')', '')
            if symbol_base in source_lower:
                return True

        if condition.node and condition.node.variables_read:
            for var in condition.node.variables_read:
                var_name = str(var.name).lower() if hasattr(var, 'name') else str(var).lower()
                if var_name in caller_symbols:
                    return True

                # Check if it's msg.sender or tx.origin
                if isinstance(var, SolidityVariableComposed):
                    if var.name in ['msg.sender', 'tx.origin']:
                        return True

        return False

    def _depends_on_state(self, condition: ConditionExpression) -> Tuple[bool, List[str]]:
        """
        Check if condition depends on authorization state

        ENHANCED: Now tracks function calls that return state variables
        (e.g., owner() getter function)

        Returns:
            tuple: (depends_on_state, list_of_state_variables)
        """
        state_vars = []

        if not condition.node:
            return False, state_vars

        # Check variables read in this node
        for var in condition.node.variables_read:
            if isinstance(var, StateVariable):
                state_vars.append(var.name)

        # Check through SlithIR for more accuracy
        if hasattr(condition.node, 'irs'):
            for ir in condition.node.irs:
                state_vars.extend(self._extract_state_from_ir(ir))

        # CRITICAL FIX: Check internal and high-level calls
        # Functions like owner() that return state variables
        state_vars.extend(self._extract_state_from_function_calls(condition))

        # Remove duplicates
        state_vars = list(set(state_vars))

        # Apply AChecker mapping filter
        if state_vars:
            filtered_vars = self._apply_mapping_filter(condition, state_vars)
            return len(filtered_vars) > 0, filtered_vars

        return False, []

    def _extract_state_from_ir(self, ir: Operation) -> List[str]:
        """Extract state variables from SlithIR operation"""
        state_vars = []

        # Check read variables in IR
        if hasattr(ir, 'read'):
            for var in ir.read:
                if isinstance(var, StateVariable):
                    state_vars.append(var.name)

        # Check for Index operations (mapping access)
        if isinstance(ir, Index):
            if isinstance(ir.variable_left, StateVariable):
                state_vars.append(ir.variable_left.name)

        # Check for Member access
        if isinstance(ir, Member):
            if isinstance(ir.variable_left, StateVariable):
                state_vars.append(ir.variable_left.name)

        return state_vars

    def _apply_mapping_filter(self, condition: ConditionExpression, state_vars: List[str]) -> List[str]:
        """
        Apply AChecker mapping filter (Key insight from paper)

        For each state variable:
        - If it's a mapping with bool value type: PASS (likely permission)
        - If it's a mapping with non-bool value type (uint, address):
            - Perform forward slice
            - If used in math operations (+, -, *, /, >, <): FAIL (business logic)
            - Otherwise: PASS
        """
        filtered = []

        for var_name in state_vars:
            # Find the state variable definition
            state_var = self._find_state_variable(var_name)
            if not state_var:
                # Can't determine, keep it
                filtered.append(var_name)
                continue

            # Check if it's a mapping
            var_type_str = str(state_var.type).lower()

            if 'mapping' in var_type_str:
                # Extract value type from mapping
                # mapping(address => bool) -> value type is bool
                # mapping(address => uint256) -> value type is uint256

                if 'bool' in var_type_str:
                    # Bool mapping: likely permission check
                    filtered.append(var_name)
                else:
                    # Non-bool mapping: need forward slice analysis
                    if not self._is_used_in_math(condition, var_name):
                        filtered.append(var_name)
                    # else: business logic, filter out
            else:
                # Not a mapping, keep it
                filtered.append(var_name)

        return filtered

    def _find_state_variable(self, var_name: str) -> Optional[StateVariable]:
        """Find state variable by name in contract"""
        for var in self.contract.state_variables:
            if var.name == var_name:
                return var

        # Check parent contracts
        for parent in self.contract.inheritance:
            for var in parent.state_variables:
                if var.name == var_name:
                    return var

        return None

    def _is_used_in_math(self, condition: ConditionExpression, var_name: str) -> bool:
        """
        Forward slice: Check if variable is used in mathematical operations

        If yes -> business logic (e.g., balances[msg.sender] > amount)
        If no -> likely permission check
        """
        if not condition.node or not hasattr(condition.node, 'irs'):
            return False

        # Check if this variable is involved in binary math operations
        for ir in condition.node.irs:
            if isinstance(ir, Binary):
                # Check operation type
                op_str = str(ir.type).lower()
                math_ops = ['add', 'sub', 'mul', 'div', 'mod', 'greater', 'less', 'geq', 'leq']

                if any(math_op in op_str for math_op in math_ops):
                    # Check if our variable is involved
                    if hasattr(ir, 'variable_left'):
                        left_str = str(ir.variable_left).lower()
                        if var_name.lower() in left_str:
                            return True
                    if hasattr(ir, 'variable_right'):
                        right_str = str(ir.variable_right).lower()
                        if var_name.lower() in right_str:
                            return True

        return False

    def _extract_state_from_function_calls(self, condition: ConditionExpression) -> List[str]:
        """
        Extract state variables from function calls in the condition

        CRITICAL for detecting patterns like: owner() == _msgSender()
        where owner() is a getter function returning state variable _owner

        Returns:
            List of state variable names accessed through function calls
        """
        state_vars = []

        if not condition.node:
            return state_vars

        # Check internal calls (functions in the same contract or inherited)
        for call in condition.node.internal_calls:
            if hasattr(call, 'function') and call.function:
                # Analyze the called function to see if it returns state variables
                state_vars.extend(self._analyze_function_return_state(call.function))

        # Check high-level calls (rare in conditions, but possible)
        # Usually these are delegated authorization checks

        # Also check through SlithIR for InternalCall operations
        if hasattr(condition.node, 'irs'):
            for ir in condition.node.irs:
                if isinstance(ir, InternalCall):
                    if ir.function and hasattr(ir.function, 'is_implemented'):
                        if ir.function.is_implemented:
                            state_vars.extend(self._analyze_function_return_state(ir.function))

        return list(set(state_vars))

    def _analyze_function_return_state(self, function: Function) -> List[str]:
        """
        Analyze a function to determine if it returns state variables

        Handles common patterns:
        1. Simple getter: function owner() returns (_owner) { return _owner; }
        2. View function returning state: function getBalance() returns (uint) { return balance; }

        Returns:
            List of state variable names returned by this function
        """
        state_vars = []

        if not function or not hasattr(function, 'is_implemented'):
            return state_vars

        if not function.is_implemented:
            return state_vars

        # Quick heuristic: if function name matches common getter pattern
        # and there's a state variable with similar name
        func_name_lower = function.name.lower()

        # Pattern 1: Direct name match (owner() -> _owner, paused() -> _paused)
        for state_var in self.contract.state_variables:
            var_name_lower = state_var.name.lower()

            # Check if function name matches state variable name
            # Examples: owner() -> _owner, paused() -> _paused
            if func_name_lower == var_name_lower:
                state_vars.append(state_var.name)
                continue

            # Check if function name is state variable name without underscore
            if func_name_lower == var_name_lower.lstrip('_'):
                state_vars.append(state_var.name)
                continue

            # Check if state variable name is function name with underscore
            if f"_{func_name_lower}" == var_name_lower:
                state_vars.append(state_var.name)
                continue

        # Pattern 2: Analyze return statements in the function
        for node in function.nodes:
            node_type_str = str(node.type).upper()

            if 'RETURN' in node_type_str:
                # Check what variables are read in this return statement
                for var in node.variables_read:
                    if isinstance(var, StateVariable):
                        state_vars.append(var.name)

                # Also check through SlithIR
                if hasattr(node, 'irs'):
                    for ir in node.irs:
                        if hasattr(ir, 'values'):
                            # Return operation with values
                            for val in ir.values:
                                if isinstance(val, StateVariable):
                                    state_vars.append(val.name)

        return list(set(state_vars))

    def _classify_condition(self, condition: ConditionExpression) -> ConditionType:
        """
        Simplified classification: Only identify PERMISSION checks

        Rules:
        - Depends on both caller AND state -> PERMISSION
        - Depends on caller AND function parameter (self-auth) -> PERMISSION
        - Everything else -> UNKNOWN (not tracked)

        Filters (to avoid false positives):
        - Zero-address checks -> UNKNOWN
        """
        # Filter out zero-address validation (parameter validation, not permission)
        if self._is_zero_address_check(condition):
            return ConditionType.UNKNOWN

        # Check for true permission checks
        if condition.depends_on_caller and condition.depends_on_state:
            return ConditionType.PERMISSION

        # Self-authorization pattern (e.g., account == msg.sender)
        if condition.depends_on_caller and self._is_self_authorization_check(condition):
            return ConditionType.PERMISSION

        # Everything else is not tracked
        return ConditionType.UNKNOWN

    def _is_numeric_comparison(self, condition: ConditionExpression) -> bool:
        """
        Check if condition involves numeric comparisons

        FIXED (Task 3): Address comparisons should NOT be classified as numeric
        """
        source_lower = condition.source_code.lower()

        # First, check if it's an address comparison (should NOT be numeric)
        # Address comparisons use == or != with address-related keywords
        if ('==' in source_lower or '!=' in source_lower):
            address_indicators = ['address', 'owner', 'sender', 'account', 'from', 'to']
            if any(indicator in source_lower for indicator in address_indicators):
                # This is an address comparison, not numeric
                return False

        # Now check for actual numeric comparison indicators
        numeric_operators = ['>', '<', '>=', '<=']
        has_numeric_operator = any(op in source_lower for op in numeric_operators)

        numeric_keywords = ['balance', 'amount', 'value', '+', '-', '*', '/']
        has_numeric_keyword = any(kw in source_lower for kw in numeric_keywords)

        return has_numeric_operator or has_numeric_keyword

    def _is_self_authorization_check(self, condition: ConditionExpression) -> bool:
        """
        Check if condition is a self-authorization pattern (Task 2)

        Detects patterns like: require(account == _msgSender(), "can only renounce roles for self")
        where the caller must be the subject of the operation.

        Returns:
            bool: True if this is a self-authorization check
        """
        if not condition.node:
            return False

        # Check if condition involves equality comparison
        source_lower = condition.source_code.lower()
        if '==' not in source_lower and '!=' not in source_lower:
            return False

        # Check if one side is a known caller symbol
        has_caller = any(symbol in source_lower for symbol in self._get_function_caller_symbols(
            getattr(condition.node, 'function', None)
        ))

        if not has_caller:
            return False

        # Check if the other side is a function parameter
        # Look for variables read that are parameters of the current function
        if not hasattr(condition.node, 'function') or not condition.node.function:
            return False

        function = condition.node.function
        if not hasattr(function, 'parameters'):
            return False

        # Check if any function parameters appear in the condition
        for param in function.parameters:
            param_name = param.name.lower()
            if param_name in source_lower:
                # This is comparing a caller with a function parameter
                # Likely a self-authorization check
                return True

        return False

    def _is_zero_address_check(self, condition: ConditionExpression) -> bool:
        """
        Check if condition is a zero-address validation check (Fix 2024-11)

        Zero-address checks are parameter validation, NOT permission checks.
        They verify that an address parameter is not the zero address.

        Examples:
        - require(from != address(0), "...")
        - require(owner != address(0), "...")
        - require(to != address(0), "...")
        - require(spender != address(0), "...")
        - require(account != address(0), "...")

        Returns:
            bool: True if this is a zero-address validation check
        """
        if not condition.source_code:
            return False

        source_lower = condition.source_code.lower()

        # Check for address(0) pattern
        zero_address_patterns = [
            'address(0)',
            'address(0x0)',
            '0x0000000000000000000000000000000000000000'
        ]

        has_zero_address = any(pattern in source_lower for pattern in zero_address_patterns)

        if not has_zero_address:
            return False

        # Check for equality/inequality operator
        if '==' not in source_lower and '!=' not in source_lower:
            return False

        # Check for typical parameter names used in zero-address checks
        # These are commonly validated parameters, not authorization entities
        param_names = [
            'from', 'to', 'owner', 'spender', 'account',
            'recipient', 'sender', 'address', 'newowner',
            'target', 'destination', 'source'
        ]

        # If any parameter name appears with zero address comparison, it's a validation check
        if any(param in source_lower for param in param_names):
            return True

        return False


# ========== Stage 3: Semantic Parsing & Classification ==========

class SemanticParser:
    """
    Stage 3: Translate code-level conditions into structured, human-readable format

    Identifies and parses patterns:
    - OWNABLE: caller == owner
    - RBAC: hasRole(role, caller)
    - WHITELIST/BLACKLIST: mapping[caller] == bool
    - STATE_LOCK: state_var == value
    - SIGNATURE: ecrecover(...) == signer
    - DELEGATED: external_contract.check(...)
    """

    def __init__(self, contract: Contract, caller_context: Dict[str, Any], function: Function = None):
        self.contract = contract
        self.caller_context = caller_context or {}
        self.current_function = function  # Store current function for modifier access

    def _get_condition_source(self, condition: ConditionExpression) -> str:
        """
        判断条件来自哪里（modifier/function_body/internal_call）

        Args:
            condition: 条件表达式对象

        Returns:
            条件来源：'modifier:修饰符名' / 'function_body' / 'internal_call:函数名' / 'unknown'
        """
        if not self.current_function:
            return "unknown"

        cond_line = condition.line
        if not cond_line:
            return "unknown"

        # 检查是否来自修饰符
        for modifier in self.current_function.modifiers:
            if modifier.source_mapping and modifier.source_mapping.lines:
                if cond_line in modifier.source_mapping.lines:
                    return f"modifier:{modifier.name}"

        # 检查是否来自函数体
        if self.current_function.source_mapping and self.current_function.source_mapping.lines:
            if cond_line in self.current_function.source_mapping.lines:
                return "function_body"

        # 默认假设来自内部调用
        return "internal_call"

    def parse_conditions(self, conditions: List[ConditionExpression]) -> List[ConditionExpression]:
        """
        Parse and classify each condition

        Args:
            conditions: Filtered conditions from Stage 2

        Returns:
            Same list with permission_model and parsed_structure populated
        """
        for condition in conditions:
            if condition.condition_type == ConditionType.PERMISSION:
                self._parse_permission_condition(condition)

        return conditions

    def _parse_permission_condition(self, condition: ConditionExpression):
        """Parse a permission condition to identify its pattern"""
        source = condition.source_code.lower()

        # Pattern 0: Self-authorization (Task 2) - Check FIRST!
        # Example: require(account == _msgSender(), "can only renounce roles for self")
        if self._is_self_auth_pattern(source, condition):
            condition.permission_model = PermissionModel.SELF_AUTH
            condition.parsed_structure = {
                "source_code": condition.source_code,
                "line": condition.line,
                "source": self._get_condition_source(condition)
            }
            return

        # Pattern 1: Simple ownership (OWNABLE)
        if self._is_ownable_pattern(source, condition):
            condition.permission_model = PermissionModel.OWNABLE
            condition.parsed_structure = {
                "source_code": condition.source_code,
                "line": condition.line,
                "source": self._get_condition_source(condition)
            }
            return

        # Pattern 2: RBAC (role-based)
        rbac_role = self._extract_rbac_role(source, condition)
        if rbac_role:
            condition.permission_model = PermissionModel.RBAC
            condition.parsed_structure = {
                "source_code": condition.source_code,
                "line": condition.line,
                "source": self._get_condition_source(condition)
            }
            return

        # Pattern 3: Whitelist/Blacklist
        list_type = self._identify_list_pattern(source, condition)
        if list_type:
            condition.permission_model = list_type
            condition.parsed_structure = {
                "source_code": condition.source_code,
                "line": condition.line,
                "source": self._get_condition_source(condition)
            }
            return

        # Pattern 4: Signature check
        if self._is_signature_pattern(source, condition):
            condition.permission_model = PermissionModel.SIGNATURE
            condition.parsed_structure = {
                "source_code": condition.source_code,
                "line": condition.line,
                "source": self._get_condition_source(condition)
            }
            return

        # Pattern 5: Delegated check
        if self._is_delegated_pattern(source, condition):
            condition.permission_model = PermissionModel.DELEGATED
            condition.parsed_structure = {
                "source_code": condition.source_code,
                "line": condition.line,
                "source": self._get_condition_source(condition)
            }
            return

        # Default: Custom permission logic
        condition.permission_model = PermissionModel.CUSTOM
        condition.parsed_structure = {
            "source_code": condition.source_code,
            "line": condition.line,
            "source": self._get_condition_source(condition)
        }

    def _parse_state_condition(self, condition: ConditionExpression):
        """Parse a state condition (e.g., paused, locked)"""
        condition.permission_model = PermissionModel.STATE_LOCK
        condition.parsed_structure = {
            "source_code": condition.source_code,
            "line": condition.line,
            "source": self._get_condition_source(condition)
        }

    def _is_ownable_pattern(self, source: str, condition: ConditionExpression) -> bool:
        """
        Detect simple ownership/role pattern

        ENHANCED: Now uses generic pattern matching instead of keyword-based detection

        Handles patterns like:
        - msg.sender == owner
        - owner() == _msgSender()  (getter function pattern)
        - _msgSender() == owner()
        - _taxWallet == _msgSender()  (any privileged address check)

        Generic Rule:
        If condition is "state_variable == caller" with equality check,
        it's likely a role/ownership check, regardless of variable name.
        """
        # Check for caller presence
        caller_keywords = ['msg.sender', 'tx.origin', '_msgsender', 'sender', 'caller']
        has_caller = any(kw in source for kw in caller_keywords)

        # Check for equality operator
        has_equality = '==' in source or '!=' in source

        if not has_caller or not has_equality:
            return False

        # Strategy 1: Keyword-based detection (original logic)
        owner_keywords = ['owner', 'admin', 'deployer', 'creator', 'manager', 'operator', 'governor']
        has_owner_keyword = any(kw in source for kw in owner_keywords)

        if has_owner_keyword:
            return True

        # Strategy 2: Generic pattern detection (NEW!)
        # If this condition involves a state variable that is:
        # 1. Address type (or looks like it stores an address)
        # 2. Being compared with equality to a caller
        # Then it's likely a role check

        if condition.state_variables:
            # Check if any state variable looks like it stores a privileged address
            for state_var_name in condition.state_variables:
                # Find the actual state variable definition
                state_var = self._find_state_variable_in_contract(state_var_name)

                if state_var:
                    # Check if it's an address type
                    var_type_str = str(state_var.type).lower()

                    if 'address' in var_type_str:
                        # This is an address state variable being compared to caller
                        # High likelihood it's a role check!

                        # Additional heuristic: check if variable name suggests privilege
                        var_name_lower = state_var_name.lower()
                        privilege_indicators = [
                            'wallet', 'receiver', 'collector', 'beneficiary',
                            'authority', 'controller', 'guardian', 'multisig',
                            'dao', 'treasury', 'fund', 'vault'
                        ]

                        # If name contains any privilege indicator, definitely a role check
                        if any(indicator in var_name_lower for indicator in privilege_indicators):
                            return True

                        # Even without indicators, address == caller is very likely a role check
                        # (as opposed to balance[caller] > amount which is business logic)
                        # We can be confident because:
                        # 1. It's an address type (not uint/bool from mapping)
                        # 2. It's equality comparison (not >, <, >=, <=)
                        # 3. It involves a caller
                        return True

        # Also check for common role patterns in source code
        role_patterns = ['wallet', 'fee', 'tax', 'treasury', 'fund']
        if any(pattern in source for pattern in role_patterns):
            return True

        return False

    def _find_state_variable_in_contract(self, var_name: str) -> Optional[StateVariable]:
        """Helper to find state variable by name"""
        for var in self.contract.state_variables:
            if var.name == var_name:
                return var

        # Check parent contracts
        for parent in self.contract.inheritance:
            for var in parent.state_variables:
                if var.name == var_name:
                    return var

        return None

    def _extract_rbac_role(self, source: str, condition: ConditionExpression) -> Optional[str]:
        """
        Extract role name from RBAC pattern

        ENHANCED: Now parses function source code directly to find modifier call arguments
        e.g., onlyRole(CONTROL_ROLE) -> extracts "CONTROL_ROLE"

        Strategy:
        1. Parse function source code to extract role constants from modifier calls
        2. Fallback to detecting RBAC patterns in condition expressions
        """
        import re

        # Strategy 1: Extract from function source code (PRIORITY!)
        # Parse the actual function definition to find modifier calls with arguments
        if self.current_function and self.current_function.source_mapping:
            try:
                # Get the function's source code from file
                source_mapping = self.current_function.source_mapping
                if source_mapping.filename and source_mapping.lines:
                    start_line = source_mapping.lines[0]
                    # Convert Slither's Filename object to string
                    filename_str = str(source_mapping.filename.absolute) if hasattr(source_mapping.filename, 'absolute') else str(source_mapping.filename)

                    # Read a reasonable number of lines to capture the full function signature
                    # (modifiers are usually within the first 10 lines of the function)
                    with open(filename_str, 'r', encoding='utf-8') as f:
                        all_lines = f.readlines()
                        # Get function signature (up to opening brace or returns statement)
                        func_lines = all_lines[start_line-1:min(start_line+15, len(all_lines))]
                        func_source = ''.join(func_lines)

                        # Look for modifier calls with role arguments
                        # Pattern: onlyRole(CONTROL_ROLE), requireRole(ADMIN_ROLE), etc.
                        modifier_pattern = r'(?:onlyRole|requireRole|checkRole)\s*\(\s*([A-Z_][A-Z0-9_]*ROLE)\s*\)'
                        match = re.search(modifier_pattern, func_source)
                        if match:
                            result = match.group(1)
                            return result
            except Exception:
                pass  # Silently fail and try fallback strategies

        # Strategy 2: Look for role patterns in the condition source code (fallback)
        # This handles cases where role constants appear in require() statements
        rbac_patterns = ['hasrole', 'onlyrole', 'checkrole', 'role']

        if any(pattern in source for pattern in rbac_patterns):
            # Try to extract role constant name from condition source
            role_pattern = r'([A-Z_]+_ROLE|[A-Z_]+ROLE)'
            match = re.search(role_pattern, condition.source_code)
            if match:
                result = match.group(1)
                return result

            # Check the entire source string
            match = re.search(role_pattern, source)
            if match:
                result = match.group(1)
                return result

            # Generic role detection (for dynamic role checks like onlyRole(getRoleAdmin(role)))
            return "ROLE_CHECK"

        return None

    def _identify_list_pattern(self, source: str, condition: ConditionExpression) -> Optional[PermissionModel]:
        """Identify whitelist/blacklist pattern"""
        # Look for mapping[caller] patterns
        whitelist_keywords = ['whitelist', 'allowed', 'authorized', 'approved']
        blacklist_keywords = ['blacklist', 'banned', 'blocked', 'denied']

        # Check state variables for list-like names
        for var_name in condition.state_variables:
            var_lower = var_name.lower()

            if any(kw in var_lower for kw in whitelist_keywords):
                return PermissionModel.WHITELIST

            if any(kw in var_lower for kw in blacklist_keywords):
                return PermissionModel.BLACKLIST

        # Check if it's a mapping with boolean checks
        if '[' in source and ']' in source:
            # Likely a mapping access
            if any(kw in source for kw in whitelist_keywords):
                return PermissionModel.WHITELIST
            if any(kw in source for kw in blacklist_keywords):
                return PermissionModel.BLACKLIST

        return None

    def _is_signature_pattern(self, source: str, condition: ConditionExpression) -> bool:
        """
        Detect signature-based authorization (Task 3 enhancement)

        Identifies patterns where authorization depends on cryptographic signature verification:
        - Direct: ecrecover(...) == signer
        - Via helper: validSign(...), verifySignature(...), etc.
        """
        # Strategy 1: Keyword-based detection
        signature_keywords = ['ecrecover', 'signature', 'signed', 'verify', 'validsign']
        has_signature_keyword = any(kw in source for kw in signature_keywords)

        if has_signature_keyword:
            return True

        # Strategy 2: Check for calls to signature verification functions
        if condition.node:
            # Check internal calls for signature-related functions
            if hasattr(condition.node, 'internal_calls'):
                for call in condition.node.internal_calls:
                    if hasattr(call, 'name'):
                        call_name = call.name.lower()
                        sig_patterns = ['verify', 'valid', 'check', 'sign']
                        if any(pattern in call_name for pattern in sig_patterns):
                            # Found a call to a verification function
                            # Check if it might be signature-related
                            if 'sign' in call_name or 'verify' in call_name:
                                return True

            # Check high-level calls for external signature verification
            if hasattr(condition.node, 'high_level_calls'):
                for call_tuple in condition.node.high_level_calls:
                    # High level calls are tuples: (contract, function)
                    if len(call_tuple) >= 2:
                        func = call_tuple[1]
                        if hasattr(func, 'name'):
                            func_name = func.name.lower()
                            if 'sign' in func_name or 'verify' in func_name:
                                return True

        return False

    def _is_delegated_pattern(self, source: str, condition: ConditionExpression) -> bool:
        """Detect cross-contract delegated checks"""
        # Look for external calls in condition
        if condition.node:
            for call in condition.node.high_level_calls:
                # External contract call in a condition
                return True

        return False

    def _is_self_auth_pattern(self, source: str, condition: ConditionExpression) -> bool:
        """
        Detect self-authorization pattern (Task 2)

        Examples:
        - require(account == _msgSender(), "can only renounce roles for self")
        - require(from == msg.sender, "must be sender")

        Returns:
            bool: True if this is a self-authorization check
        """
        # Check if condition involves equality comparison
        if '==' not in source and '!=' not in source:
            return False

        # Check if one side is a known caller symbol
        caller_keywords = ['msg.sender', 'tx.origin', '_msgsender', 'msgsender']
        has_caller = any(kw in source for kw in caller_keywords)

        if not has_caller:
            return False

        # Check if the other side looks like a function parameter
        # Common parameter names that represent the subject: account, from, user, addr, etc.
        subject_param_names = ['account', 'from', 'user', 'addr', 'who', 'sender']
        has_subject_param = any(param in source for param in subject_param_names)

        if has_subject_param:
            return True

        # More rigorous check: inspect the node's variables
        if condition.node and hasattr(condition.node, 'function') and condition.node.function:
            function = condition.node.function
            if hasattr(function, 'parameters'):
                for param in function.parameters:
                    param_name = param.name.lower()
                    if param_name in source:
                        # This is comparing caller with a function parameter
                        return True

        return False


# ========== Permission Profile Generator ==========

class PermissionProfileGenerator:
    """
    Combines all three stages to generate the final Permission Profile
    """

    def __init__(self, contract: Contract, sol_path: Path, caller_context: Dict, persistent_roles: Set):
        self.contract = contract
        self.sol_path = sol_path
        self.caller_context = caller_context
        self.persistent_roles = persistent_roles

        # Initialize Stage 1 and 2 (function-independent)
        self.stage1 = GuardStatementScanner(contract, sol_path)
        self.stage2 = PermissionHeuristicFilter(contract, caller_context, persistent_roles)
        # Note: stage3 (SemanticParser) is initialized per-function to access modifiers

    def generate_profile(self, function: Function) -> Dict[str, Any]:
        """
        Generate simplified permission profile for a function

        Returns:
            {
                "function": "functionName(params)",
                "permission_checks": {...},
                "raw_condition_count": int,
                "permission_condition_count": int
            }
        """
        # Stage 1: Scan for all conditions
        all_conditions = self.stage1.scan_function(function, include_modifiers=True)

        raw_count = len(all_conditions)

        if not all_conditions:
            return {
                "function": function.full_name,
                "visibility": function.visibility,
                "modifiers": [m.name for m in function.modifiers],
                "metadata": {
                    "contract": function.contract.name if function.contract else "Unknown",
                    "start_line": function.source_mapping.lines[0] if function.source_mapping and function.source_mapping.lines else None
                },
                "permission_checks": None,
                "raw_condition_count": 0,
                "permission_condition_count": 0
            }

        # Stage 2: Filter using AChecker heuristics
        filtered_conditions = self.stage2.filter_conditions(all_conditions)

        # Stage 3: Parse and classify (INITIALIZE PER-FUNCTION for modifier access)
        stage3 = SemanticParser(self.contract, self.caller_context, function)
        classified_conditions = stage3.parse_conditions(filtered_conditions)

        # Only extract PERMISSION conditions
        permission_conditions = [
            c for c in classified_conditions
            if c.condition_type == ConditionType.PERMISSION
        ]

        # Build permission checks structure
        permission_checks = None
        if permission_conditions:
            conditions_list = []
            for cond in permission_conditions:
                if cond.parsed_structure:
                    conditions_list.append(cond.parsed_structure)

            if conditions_list:
                # ✅ 直接返回数组，删除 logic 包装
                permission_checks = conditions_list

        function_key = format_function_key(
            function.contract.name if function.contract else self.contract.name,
            function.full_name
        )

        return {
            "function": function_key,
            "visibility": function.visibility,
            "modifiers": [m.name for m in function.modifiers],
            "metadata": {
                "contract": function.contract.name if function.contract else "Unknown",
                "start_line": function.source_mapping.lines[0] if function.source_mapping and function.source_mapping.lines else None
            },
            "permission_checks": permission_checks,
            "raw_condition_count": raw_count,
            "permission_condition_count": len(permission_conditions)
        }


# ========== Main Analysis Workflow ==========

def analyze_contract(sol_path: Path, output_dir: Path) -> Optional[Dict[str, Any]]:
    """
    Main entry point: Analyze a contract and generate permission profiles

    Args:
        sol_path: Path to Solidity file
        output_dir: Base output directory

    Returns:
        Analysis results or None on error
    """
    contract_name = sol_path.stem
    print(f"\n{'='*80}")
    print(f"📄 Analyzing: {contract_name}")
    print(f"{'='*80}")

    # Load step1.1 results
    print("📥 Loading step1.1 caller analysis...")
    caller_context, persistent_roles = load_caller_analysis(contract_name, output_dir)

    symbol_count = caller_context.get('symbol_count', 0)
    if symbol_count == 0:
        print("  ⚠️  No caller map found. Some analysis may be limited.")
    else:
        print(f"  ✓ Loaded {symbol_count} caller symbols")

    if persistent_roles:
        print(f"  ✓ Identified {len(persistent_roles)} persistent roles: {persistent_roles}")

    # Initialize Slither with automatic version management
    print("\n📦 Initializing Slither...")
    slither = init_slither(str(sol_path))
    if slither is None:
        print(f"  ❌ Slither initialization failed")
        return None

    results = {
        "contract_name": contract_name,
        "contract_path": str(sol_path),
        "functions": {}
    }

    # Analyze each contract
    for contract in slither.contracts:
        if contract.is_interface:
            continue

        print(f"\n🔍 Analyzing contract: {contract.name}")

        # Initialize profile generator
        generator = PermissionProfileGenerator(
            contract, sol_path, caller_context, persistent_roles
        )

        # Analyze each function
        func_count = 0
        for function in contract.functions:
            if function.is_constructor or function.is_fallback or function.is_receive:
                continue

            profile = generator.generate_profile(function)

            # Only include functions with permission checks
            if profile['permission_checks']:
                func_key = profile["function"]
                results["functions"][func_key] = profile
                func_count += 1

        print(f"  ✓ Generated profiles for {func_count} functions")

    # Save results
    if results["functions"]:
        contract_output_dir = output_dir / contract_name / "step1"
        contract_output_dir.mkdir(parents=True, exist_ok=True)
        outfile = contract_output_dir / "step1.2_permission_profile.json"

        with open(outfile, "w", encoding="utf-8") as f:
            json.dump(results, f, indent=2, ensure_ascii=False)

        print(f"\n💾 Results saved to: {outfile.relative_to(output_dir)}")

        # Print summary statistics
        total_permission_funcs = sum(
            1 for f in results["functions"].values()
            if f["permission_checks"]
        )

        print(f"\n📊 Summary:")
        print(f"  • Functions with permission checks: {total_permission_funcs}")
    else:
        print("\n  ℹ️  No permission-controlled functions found")

    return results


def main():
    """Script main entry point"""
    print("\n" + "="*80)
    print("🚀 High-Precision Permission Analysis Engine")
    print("   Simplified Version: Permission Checks Only")
    print("="*80)

    project_root, contracts_dir, output_dir = setup_project_paths()
    if not project_root:
        return

    print(f"\nProject root: {project_root}")
    print(f"Contracts directory: {contracts_dir}")
    print(f"Output directory: {output_dir}")

    sol_files = list(contracts_dir.glob("*.sol"))
    if not sol_files:
        print("\n❌ No .sol files found in 'contracts' directory.")
        return

    print(f"\n📋 Found {len(sol_files)} contract(s) to analyze")

    all_results = []
    for sol_file in sol_files:
        result = analyze_contract(sol_file, output_dir)
        if result:
            all_results.append(result)

    # Final summary
    print("\n" + "="*80)
    print("📊 Final Summary")
    print("="*80)
    total_contracts = len(all_results)
    total_functions = sum(len(r['functions']) for r in all_results)

    print(f"Contracts analyzed: {total_contracts}")
    print(f"Permission-controlled functions: {total_functions}")
    print("\n✅ Permission analysis complete!")


if __name__ == "__main__":
    main()
