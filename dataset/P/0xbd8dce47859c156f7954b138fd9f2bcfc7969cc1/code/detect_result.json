{
    "DT": {
        "openTrading()": [
            {
                "Expr": "uniswapV2Router.addLiquidityETH{value: address(this).balance}(address(this),balanceOf(address(this)),0,0,owner(),block.timestamp)",
                "Trapdoor": "Modifier"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "_reduceTaxCountdown > 0"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "(_reduceTaxCountdown == 0)"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "! inSwap && from != uniswapV2Pair && swapEnabled && contractTokenBalance > 0 && _reduceTaxCountdown < 40"
            },
            {
                "Expr": "sendETHToFee(address(this).balance)",
                "Trapdoor": "from == uniswapV2Pair && to != address(uniswapV2Router) && ! _isExcludedFromFee[to] && cooldownEnabled"
            }
        ],
        "manualsend()": [
            {
                "Expr": "sendETHToFee(contractETHBalance)",
                "Trapdoor": "require(bool)(_msgSender() == _feeAddrWallet)"
            }
        ]
    },
    "DPW": {},
    "IDT": {
        "setCooldownEnabled(bool)": [
            {
                "Expr": "cooldownEnabled = onoff",
                "W_TDS": "['cooldownEnabled']",
                "Trapdoor": "Modifier"
            }
        ],
        "removeLimits()": [
            {
                "Expr": "_maxWalletSize = _tTotal",
                "W_TDS": "['_maxWalletSize']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "_maxTxAmount = _tTotal",
                "W_TDS": "['_maxTxAmount']",
                "Trapdoor": "Modifier"
            }
        ],
        "addBots(address[])": [
            {
                "Expr": "bots[bots_[i]] = true",
                "W_TDS": "['bots']",
                "Trapdoor": "Modifier"
            }
        ],
        "delBots(address[])": [
            {
                "Expr": "bots[notbot[i]] = false",
                "W_TDS": "['bots']",
                "Trapdoor": "Modifier"
            }
        ],
        "openTrading()": [
            {
                "Expr": "tradingOpen = true",
                "W_TDS": "['tradingOpen']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "uniswapV2Router = _uniswapV2Router",
                "W_TDS": "['uniswapV2Router']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "swapEnabled = true",
                "W_TDS": "['swapEnabled']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "uniswapV2Pair = IUniswapV2Factory(_uniswapV2Router.factory()).createPair(address(this),_uniswapV2Router.WETH())",
                "W_TDS": "['uniswapV2Pair']",
                "Trapdoor": "Modifier"
            },
            {
                "Expr": "cooldownEnabled = true",
                "W_TDS": "['cooldownEnabled']",
                "Trapdoor": "Modifier"
            }
        ],
        "_transfer(address,address,uint256)": [
            {
                "Expr": "_reduceTaxCountdown --",
                "W_TDS": "['_reduceTaxCountdown']",
                "Trapdoor": "from == uniswapV2Pair && to != address(uniswapV2Router) && ! _isExcludedFromFee[to] && cooldownEnabled"
            },
            {
                "Expr": "_reduceTaxCountdown --",
                "W_TDS": "['_reduceTaxCountdown']",
                "Trapdoor": "_reduceTaxCountdown > 0"
            },
            {
                "Expr": "_reduceTaxCountdown --",
                "W_TDS": "['_reduceTaxCountdown']",
                "Trapdoor": "(_reduceTaxCountdown == 0)"
            }
        ],
        "constructor": [
            {
                "Expr": "_isExcludedFromFee[owner()] = true",
                "W_TDS": "['_isExcludedFromFee']",
                "Trapdoor": "constructor"
            }
        ]
    },
    "IDPW": {},
    "FLAG": true
}